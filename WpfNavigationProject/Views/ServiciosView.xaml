 <UserControl x:Class="WpfNavigationProject.Views.ServiciosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="600"
             d:DesignWidth="1000"
             Loaded="UserControl_Loaded">

    <Border Background="White"
            CornerRadius="10"
            Padding="20"
            Margin="10">

        <Grid>

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="15"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>


            <!-- ================================================= -->
            <!-- TÍTULO -->
            <!-- ================================================= -->

            <TextBlock Grid.Row="0"
                       Text="Listado de Servicios"
                       FontSize="24"
                       FontWeight="Bold"
                       Foreground="#1E293B"
                       Margin="0,0,0,15"/>


            <!-- ================================================= -->
            <!-- PANEL DE FILTROS -->
            <!-- ================================================= -->

            <Border Grid.Row="1"
                    Background="#F8FAFC"
                    BorderBrush="#E2E8F0"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="15">

                <Grid>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>


                    <!-- ============================= -->
                    <!-- BÚSQUEDA -->
                    <!-- ============================= -->

                    <Grid Grid.Row="0"
                          Margin="0,0,0,12">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="180"/>
                        </Grid.ColumnDefinitions>

                        <TextBox x:Name="TxtBuscar"
                                 Grid.Column="0"
                                 Height="32"
                                 Padding="10,5"
                                 FontSize="14"
                                 VerticalContentAlignment="Center"
                                 TextChanged="TxtBuscar_TextChanged"/>

                        <ComboBox x:Name="CmbBuscarPor"
                                  Grid.Column="1"
                                  Height="32"
                                  Margin="10,0,0,0"
                                  VerticalContentAlignment="Center"
                                  SelectedIndex="0"
                                  SelectionChanged="CmbBuscarPor_SelectionChanged">

                            <ComboBoxItem Content="Cliente"
                                          Tag="Nombre"/>

                            <ComboBoxItem Content="Marca"
                                          Tag="Marca"/>

                            <ComboBoxItem Content="Modelo"
                                          Tag="Modelo"/>

                        </ComboBox>

                    </Grid>


                    <!-- ============================= -->
                    <!-- ESTADO -->
                    <!-- ============================= -->

                    <StackPanel Grid.Row="1"
                                Orientation="Horizontal"
                                Margin="0,0,0,12">

                        <TextBlock Text="Estado:"
                                   FontWeight="SemiBold"
                                   Foreground="#475569"
                                   VerticalAlignment="Center"
                                   Margin="0,0,15,0"/>

                        <RadioButton x:Name="RbTodos"
                                     Content="Todos"
                                     GroupName="EstadoServicio"
                                     Margin="0,0,20,0"
                                     IsChecked="True"
                                     Checked="FiltroCambiado"/>

                        <RadioButton x:Name="RbIngresado"
                                     Content="Ingresado"
                                     GroupName="EstadoServicio"
                                     Margin="0,0,20,0"
                                     Checked="FiltroCambiado"/>

                        <RadioButton x:Name="RbEnProceso"
                                     Content="En proceso"
                                     GroupName="EstadoServicio"
                                     Margin="0,0,20,0"
                                     Checked="FiltroCambiado"/>

                        <RadioButton x:Name="RbTerminado"
                                     Content="Terminado"
                                     GroupName="EstadoServicio"
                                     Margin="0,0,20,0"
                                     Checked="FiltroCambiado"/>

                        <RadioButton x:Name="RbPagado"
                                     Content="Pagado"
                                     GroupName="EstadoServicio"
                                     Margin="0,0,20,0"
                                     Checked="FiltroCambiado"/>

                    </StackPanel>


                    <!-- ============================= -->
                    <!-- FECHAS -->
                    <!-- ============================= -->

                    <Grid Grid.Row="2">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="140"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="140"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>


                        <TextBlock Grid.Column="0"
                                   Text="Fecha de ingreso:"
                                   FontWeight="SemiBold"
                                   Foreground="#475569"
                                   VerticalAlignment="Center"
                                   Margin="0,0,10,0"/>

                        <DatePicker x:Name="DpFechaDesde"
                                    Grid.Column="1"
                                    Height="32"
                                    SelectedDateChanged="Fecha_SelectedDateChanged"/>


                        <TextBlock Grid.Column="2"
                                   Text="Hasta:"
                                   Foreground="#475569"
                                   VerticalAlignment="Center"
                                   Margin="15,0,10,0"/>

                        <DatePicker x:Name="DpFechaHasta"
                                    Grid.Column="3"
                                    Height="32"
                                    SelectedDateChanged="Fecha_SelectedDateChanged"/>


                        <Button x:Name="BtnLimpiarFiltros"
                                Grid.Column="5"
                                Content="Limpiar filtros"
                                Height="32"
                                Padding="15,0"
                                Background="#E2E8F0"
                                Foreground="#334155"
                                BorderThickness="0"
                                Cursor="Hand"
                                Click="BtnLimpiarFiltros_Click"/>

                    </Grid>

                </Grid>

            </Border>


            <!-- ================================================= -->
            <!-- DATAGRID -->
            <!-- ================================================= -->

            <DataGrid x:Name="ServiciosDataGrid"
                      Grid.Row="3"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      SelectionMode="Single"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal"
                      HorizontalGridLinesBrush="#E5E7EB"
                      Background="White"
                      RowBackground="White"
                      AlternatingRowBackground="#F8FAFC"
                      BorderThickness="0"
                      FontSize="13">

                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">

                        <Setter Property="Background"
                                Value="#2563EB"/>

                        <Setter Property="Foreground"
                                Value="White"/>

                        <Setter Property="FontWeight"
                                Value="SemiBold"/>

                        <Setter Property="Padding"
                                Value="8"/>

                        <Setter Property="HorizontalContentAlignment"
                                Value="Center"/>

                    </Style>
                </DataGrid.ColumnHeaderStyle>


                <DataGrid.Columns>

                    <!-- ================================================= -->
                    <!-- CLIENTE -->
                    <!-- ================================================= -->

                    <DataGridTextColumn Header="Cliente"
                                        Binding="{Binding NombreCliente}"
                                        Width="2*"/>


                    <!-- ================================================= -->
                    <!-- MARCA -->
                    <!-- ================================================= -->

                    <DataGridTextColumn Header="Marca"
                                        Binding="{Binding MarcaMoto}"
                                        Width="1.3*"/>


                    <!-- ================================================= -->
                    <!-- MODELO -->
                    <!-- ================================================= -->

                    <DataGridTextColumn Header="Modelo"
                                        Binding="{Binding ModeloMoto}"
                                        Width="1.3*"/>


                    <!-- ================================================= -->
                    <!-- ESTADO -->
                    <!-- ================================================= -->

                    <DataGridTextColumn Header="Estado"
                                        Binding="{Binding NombreEstado}"
                                        Width="1.2*"/>


                    <!-- ================================================= -->
                    <!-- FECHA DE INGRESO -->
                    <!-- ================================================= -->

                    <DataGridTextColumn Header="Fecha de ingreso"
                                        Binding="{Binding FechaEntrada, StringFormat={}{0:dd/MM/yyyy}}"
                                        Width="1.4*"/>


                    <!-- ================================================= -->
                    <!-- DETALLE -->
                    <!-- ================================================= -->

                    <DataGridTextColumn Header="Detalle"
                                        Binding="{Binding Detalle}"
                                        Width="2.5*"/>


                    <!-- ================================================= -->
                    <!-- PRECIO -->
                    <!-- ================================================= -->

                    <DataGridTextColumn Header="Precio"
                                        Binding="{Binding CostoEstimado, StringFormat={}{0:C0}}"
                                        Width="1.2*"/>


                    <!-- ================================================= -->
                    <!-- ACCIONES -->
                    <!-- ================================================= -->

                    <DataGridTemplateColumn Header="Acciones"
                                            Width="100">

                        <DataGridTemplateColumn.CellTemplate>

                            <DataTemplate>

                                <Button Content="Editar"
                                        Width="75"
                                        Height="28"
                                        Background="#2563EB"
                                        Foreground="White"
                                        BorderThickness="0"
                                        Cursor="Hand"
                                        Tag="{Binding IdServicio}"
                                        Click="BtnEditar_Click"/>

                            </DataTemplate>

                        </DataGridTemplateColumn.CellTemplate>

                    </DataGridTemplateColumn>

                </DataGrid.Columns>

            </DataGrid>


            <!-- ================================================= -->
            <!-- BOTÓN NUEVO SERVICIO -->
            <!-- ================================================= -->

            <Button Grid.Row="4"
                    Content="+ Nuevo Servicio"
                    Width="170"
                    Height="38"
                    HorizontalAlignment="Right"
                    Margin="0,15,0,0"
                    Background="#2563EB"
                    Foreground="White"
                    FontWeight="SemiBold"
                    BorderThickness="0"
                    Cursor="Hand"
                    Click="BtnNuevoServicio_Click"/>

        </Grid>

    </Border>

</UserControl>
