<UserControl x:Class="WpfNavigationProject.Views.ServiciosView"
          xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
          xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
          xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
          xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
          mc:Ignorable="d"
          d:DesignHeight="450"
          d:DesignWidth="800"
          Background="Transparent"
          Loaded="UserControl_Loaded">

    <UserControl.Resources>

        <!-- Sombra estándar -->
        <DropShadowEffect x:Key="ShadowDepth3"
                      Color="Black"
                      Direction="270"
                      ShadowDepth="3"
                      BlurRadius="5"
                      Opacity="0.1"/>

    </UserControl.Resources>

    <Border Background="White"
        CornerRadius="15"
        Padding="30"
        Effect="{StaticResource ShadowDepth3}">

        <Grid>

            <Grid.RowDefinitions>

                <!-- Título -->
                <RowDefinition Height="Auto"/>

                <!-- Filtros -->
                <RowDefinition Height="Auto"/>

                <!-- Tabla -->
                <RowDefinition Height="*"/>

                <!-- Paginación -->
                <RowDefinition Height="Auto"/>

                <!-- Botón -->
                <RowDefinition Height="Auto"/>

            </Grid.RowDefinitions>


            <!-- ===================================================== -->
            <!-- TÍTULO -->
            <!-- ===================================================== -->

            <TextBlock Grid.Row="0"
                   Text="Listado de Servicios"
                   FontSize="36"
                   FontWeight="Bold"
                   Foreground="#333333"
                   Margin="0,-10,0,15"
                   TextAlignment="Center"/>


            <!-- ===================================================== -->
            <!-- PANEL DE FILTROS -->
            <!-- ===================================================== -->

            <Border Grid.Row="1"
                Background="#F5F7FA"
                CornerRadius="10"
                Padding="15"
                Margin="0,0,0,15">

                <Grid>

                    <Grid.RowDefinitions>

                        <!-- Primera fila: búsqueda + botón -->
                        <RowDefinition Height="Auto"/>

                        <!-- Segunda fila: estado + fechas -->
                        <RowDefinition Height="Auto"/>

                    </Grid.RowDefinitions>


                    <!-- ================================================= -->
                    <!-- PRIMERA FILA -->
                    <!-- BUSCAR + BUSCAR POR + LIMPIAR -->
                    <!-- ================================================= -->

                    <Grid Grid.Row="0"
                      Margin="0,0,0,12">

                        <Grid.ColumnDefinitions>

                            <!-- Buscar -->
                            <ColumnDefinition Width="1.7*"/>

                            <!-- Campo -->
                            <ColumnDefinition Width="1.1*"/>

                            <!-- Espacio -->
                            <ColumnDefinition Width="20"/>

                            <!-- Botón -->
                            <ColumnDefinition Width="Auto"/>

                        </Grid.ColumnDefinitions>


                        <!-- BUSCAR -->

                        <StackPanel Grid.Column="0"
                                Margin="0,0,10,0">

                            <TextBlock Text="Buscar"
                                   FontWeight="SemiBold"
                                   Foreground="#444444"
                                   Margin="0,0,0,5"/>

                            <TextBox x:Name="TxtBuscar"
                                 Height="32"
                                 Padding="8,4"
                                 VerticalContentAlignment="Center"
                                 TextChanged="TxtBuscar_TextChanged"/>

                        </StackPanel>


                        <!-- BUSCAR POR -->

                        <StackPanel Grid.Column="1">

                            <TextBlock Text="Buscar por"
                                   FontWeight="SemiBold"
                                   Foreground="#444444"
                                   Margin="0,0,0,5"/>

                            <ComboBox x:Name="CmbBuscarPor"
                                  Height="32"
                                  SelectedIndex="0"
                                  SelectionChanged="CmbBuscarPor_SelectionChanged">

                                <ComboBoxItem Content="Cliente"
                                          Tag="Nombre"/>

                                <ComboBoxItem Content="Marca"
                                          Tag="Marca"/>

                                <ComboBoxItem Content="Modelo"
                                          Tag="Modelo"/>

                            </ComboBox>

                        </StackPanel>


                        <!-- BOTÓN LIMPIAR -->

                        <Button Grid.Column="3"
                            Content="🧹 Limpiar"
                            Height="32"
                            Width="100"
                            VerticalAlignment="Bottom"
                            Click="BtnLimpiarFiltros_Click"
                            Style="{StaticResource AccionButtonStyle}"/>

                    </Grid>


                    <!-- ================================================= -->
                    <!-- SEGUNDA FILA -->
                    <!-- ESTADO + FECHAS -->
                    <!-- ================================================= -->

                    <Grid Grid.Row="1">

                        <Grid.ColumnDefinitions>

                            <!-- Estado -->
                            <ColumnDefinition Width="2.7*"/>

                            <!-- Fecha desde -->
                            <ColumnDefinition Width="1.3*"/>

                            <!-- Fecha hasta -->
                            <ColumnDefinition Width="1.3*"/>

                        </Grid.ColumnDefinitions>


                        <!-- ESTADO -->

                        <StackPanel Grid.Column="0"
                                Margin="0,0,20,0">

                            <TextBlock Text="Estado"
                                   FontWeight="SemiBold"
                                   Foreground="#444444"
                                   Margin="0,0,0,5"/>

                            <StackPanel Orientation="Horizontal"
                                    VerticalAlignment="Center">

                                <RadioButton x:Name="RbTodos"
                                         Content="Todos"
                                         GroupName="EstadoServicio"
                                         Margin="0,0,18,0"
                                         IsChecked="True"
                                         Checked="FiltroCambiado"/>

                                <RadioButton x:Name="RbIngresado"
                                         Content="Ingresado"
                                         GroupName="EstadoServicio"
                                         Margin="0,0,18,0"
                                         Checked="FiltroCambiado"/>

                                <RadioButton x:Name="RbEnProceso"
                                         Content="En proceso"
                                         GroupName="EstadoServicio"
                                         Margin="0,0,18,0"
                                         Checked="FiltroCambiado"/>

                                <RadioButton x:Name="RbTerminado"
                                         Content="Terminado"
                                         GroupName="EstadoServicio"
                                         Margin="0,0,18,0"
                                         Checked="FiltroCambiado"/>

                                <RadioButton x:Name="RbPagado"
                                         Content="Pagado"
                                         GroupName="EstadoServicio"
                                         Checked="FiltroCambiado"/>

                            </StackPanel>

                        </StackPanel>


                        <!-- FECHA DESDE -->

                        <StackPanel Grid.Column="1"
                                Margin="0,0,15,0">

                            <TextBlock Text="Ingreso desde"
                                   FontWeight="SemiBold"
                                   Foreground="#444444"
                                   Margin="0,0,0,5"/>

                            <DatePicker x:Name="DpFechaDesde"
                                    Height="32"
                                    SelectedDateChanged="Fecha_SelectedDateChanged"/>

                        </StackPanel>


                        <!-- FECHA HASTA -->

                        <StackPanel Grid.Column="2">

                            <TextBlock Text="Ingreso hasta"
                                   FontWeight="SemiBold"
                                   Foreground="#444444"
                                   Margin="0,0,0,5"/>

                            <DatePicker x:Name="DpFechaHasta"
                                    Height="32"
                                    SelectedDateChanged="Fecha_SelectedDateChanged"/>

                        </StackPanel>

                    </Grid>

                </Grid>

            </Border>


            <!-- ===================================================== -->
            <!-- TABLA DE SERVICIOS -->
            <!-- ===================================================== -->

            <DataGrid Grid.Row="2"
                  Name="ServiciosDataGrid"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  SelectionMode="Single"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  GridLinesVisibility="Horizontal"
                  RowBackground="LightGray"
                  AlternatingRowBackground="#FFEFEFEF"
                  CanUserResizeColumns="True"
                  Foreground="#FF2A2A2A"
                  FontSize="14"
                  FontWeight="SemiBold"
                  HeadersVisibility="Column">

                <DataGrid.ColumnHeaderStyle>

                    <Style TargetType="{x:Type DataGridColumnHeader}">

                        <Setter Property="Background"
                            Value="#FF007ACC"/>

                        <Setter Property="Foreground"
                            Value="White"/>

                        <Setter Property="HorizontalContentAlignment"
                            Value="Center"/>

                        <Setter Property="Padding"
                            Value="5"/>

                    </Style>

                </DataGrid.ColumnHeaderStyle>


                <DataGrid.Columns>

                    <!-- CLIENTE -->

                    <DataGridTextColumn Header="Cliente"
                                    Binding="{Binding NombreCliente}"
                                    Width="1.5*"/>


                    <!-- MARCA -->

                    <DataGridTextColumn Header="Marca"
                                    Binding="{Binding MarcaMoto}"
                                    Width="1.1*"/>


                    <!-- MODELO -->

                    <DataGridTextColumn Header="Modelo"
                                    Binding="{Binding ModeloMoto}"
                                    Width="1.2*"/>


                    <!-- ESTADO -->

                    <DataGridTextColumn Header="Estado"
                                    Binding="{Binding NombreEstado}"
                                    Width="1.2*"/>


                    <!-- FECHA DE INGRESO -->

                    <DataGridTextColumn Header="Fecha Ingreso"
                                    Binding="{Binding FechaEntrada, StringFormat={}{0:dd/MM/yyyy}}"
                                    Width="110">

                        <DataGridTextColumn.ElementStyle>

                            <Style TargetType="TextBlock">

                                <Setter Property="HorizontalAlignment"
                                    Value="Center"/>

                            </Style>

                        </DataGridTextColumn.ElementStyle>

                    </DataGridTextColumn>


                    <!-- DETALLE -->

                    <DataGridTextColumn Header="Detalle"
                                    Binding="{Binding Detalle}"
                                    Width="2.2*"/>


                    <!-- PRECIO -->

                    <DataGridTextColumn Header="Precio"
                                    Binding="{Binding CostoEstimado, StringFormat={}{0:C0}}"
                                    Width="1.2*">

                        <DataGridTextColumn.ElementStyle>

                            <Style TargetType="TextBlock">

                                <Setter Property="HorizontalAlignment"
                                    Value="Center"/>

                            </Style>

                        </DataGridTextColumn.ElementStyle>

                    </DataGridTextColumn>


                    <!-- EDITAR -->

                    <DataGridTemplateColumn Header="Editar"
                                        Width="110">

                        <DataGridTemplateColumn.CellTemplate>

                            <DataTemplate>

                                <Button Content="✏️ Editar"
                                    Click="BtnEditar_Click"
                                    Margin="2"
                                    Tag="{Binding IdServicio}"
                                    Style="{StaticResource AccionButtonStyle}"/>

                            </DataTemplate>

                        </DataGridTemplateColumn.CellTemplate>

                    </DataGridTemplateColumn>

                </DataGrid.Columns>

            </DataGrid>


            <!-- ===================================================== -->
            <!-- PAGINACIÓN -->
            <!-- ===================================================== -->

            <StackPanel Grid.Row="3"
                    Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Margin="0,15,0,0">

                <Button x:Name="BtnPaginaAnterior"
                    Content="◀ Anterior"
                    Width="100"
                    Height="32"
                    Margin="0,0,10,0"
                    Click="BtnPaginaAnterior_Click"
                    Style="{StaticResource AccionButtonStyle}"/>

                <TextBlock x:Name="TxtPaginaActual"
                       Text="Página 1 de 1"
                       VerticalAlignment="Center"
                       FontWeight="SemiBold"
                       Foreground="#444444"
                       Margin="5,0"/>

                <Button x:Name="BtnPaginaSiguiente"
                    Content="Siguiente ▶"
                    Width="100"
                    Height="32"
                    Margin="10,0,0,0"
                    Click="BtnPaginaSiguiente_Click"
                    Style="{StaticResource AccionButtonStyle}"/>

            </StackPanel>


            <!-- ===================================================== -->
            <!-- NUEVO SERVICIO -->
            <!-- ===================================================== -->

            <Button Grid.Row="4"
                Content="+ Nuevo Servicio"
                Name="BtnNuevoServicio"
                Click="BtnNuevoServicio_Click"
                Style="{StaticResource AccionButtonStyle}"
                Margin="0,20,0,0"
                HorizontalAlignment="Center"
                Width="180"
                Height="35"/>

        </Grid>

    </Border>

</UserControl>
