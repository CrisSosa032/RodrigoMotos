<UserControl x:Class="WpfNavigationProject.Views.UsuarioFormView"
          xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
          xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
          xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
          xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
          mc:Ignorable="d"
          d:DesignHeight="550"
          d:DesignWidth="800">

    
    <Grid Margin="20">

        <Border Background="#F9F9F9"
            CornerRadius="10"
            Padding="30"
            BorderBrush="#DDD"
            BorderThickness="1"
            HorizontalAlignment="Center"
            VerticalAlignment="Center">

            <Grid Width="600"
              VerticalAlignment="Top">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="0.5*"/>
                </Grid.ColumnDefinitions>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="25"/>

                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="15"/>

                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="15"/>

                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="15"/>

                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="15"/>

                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="30"/>

                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>


                <!-- =================================================
                 TÍTULO
                 ================================================= -->

                <Label Name="TxtTitulo"
                   Grid.Column="0"
                   Grid.ColumnSpan="3"
                   Content="Nuevo Usuario"
                   FontSize="24"
                   FontWeight="Bold"
                   Foreground="#007ACC"
                   Margin="0,0,0,20"/>


                <!-- =================================================
                 USUARIO
                 ================================================= -->

                <Label Grid.Column="0"
                   Grid.Row="2"
                   Content="Usuario:"
                   VerticalAlignment="Center"
                   FontWeight="SemiBold"/>

                <TextBox Grid.Column="1"
                     Grid.Row="2"
                     Name="TxtUsername"
                     Padding="5"
                     VerticalContentAlignment="Center"
                     Height="35"/>


                <!-- =================================================
                 NOMBRE
                 ================================================= -->

                <Label Grid.Column="0"
                   Grid.Row="4"
                   Content="Nombre:"
                   VerticalAlignment="Center"
                   FontWeight="SemiBold"/>

                <TextBox Grid.Column="1"
                     Grid.Row="4"
                     Name="TxtNombre"
                     Padding="5"
                     VerticalContentAlignment="Center"
                     Height="35"/>


                <!-- =================================================
                 ROL
                 ================================================= -->

                <Label Grid.Column="0"
                   Grid.Row="6"
                   Content="Rol:"
                   VerticalAlignment="Center"
                   FontWeight="SemiBold"/>

                <ComboBox Grid.Column="1"
                      Grid.Row="6"
                      Name="CmbRol"
                      Height="35"
                      Padding="5"
                      VerticalContentAlignment="Center">

                    <ComboBoxItem Content="Admin"/>
                    <ComboBoxItem Content="Empleado"/>

                </ComboBox>


                <!-- =================================================
                 CONTRASEÑA
                 ================================================= -->

                <Label Grid.Column="0"
                   Grid.Row="8"
                   Content="Contraseña:"
                   VerticalAlignment="Center"
                   FontWeight="SemiBold"/>

                <PasswordBox Grid.Column="1"
                         Grid.Row="8"
                         Name="TxtPassword"
                         Padding="5"
                         VerticalContentAlignment="Center"
                         Height="35"/>


                <!-- =================================================
                 CONFIRMAR CONTRASEÑA
                 ================================================= -->

                <Label Grid.Column="0"
                   Grid.Row="10"
                   Content="Confirmar contraseña:"
                   VerticalAlignment="Center"
                   FontWeight="SemiBold"/>

                <PasswordBox Grid.Column="1"
                         Grid.Row="10"
                         Name="TxtConfirmarPassword"
                         Padding="5"
                         VerticalContentAlignment="Center"
                         Height="35"/>


                <!-- =================================================
                 BOTÓN GUARDAR / ACTUALIZAR
                 ================================================= -->

                <Button Grid.Column="1"
                    Grid.Row="12"
                    Name="BtnGuardar"
                    Content="Guardar"
                    Grid.ColumnSpan="2"
                    Margin="0,15,0,0"
                    HorizontalAlignment="left"
                    Width="100"
                    Height="40"
                    Click="BtnGuardar_Click"/>


                <!-- =================================================
                 BOTÓN CANCELAR
                 ================================================= -->

                <Button Grid.Column="1"
                    Grid.Row="12"
                    Name="BtnCancelar"
                    Content="Cancelar"
                    Margin="10,15,0,0"
                    HorizontalAlignment="Right"
                    Width="100"
                    Height="40"
                    Click="BtnCancelar_Click"/>

            </Grid>

        </Border>

    </Grid>
    

</UserControl>
