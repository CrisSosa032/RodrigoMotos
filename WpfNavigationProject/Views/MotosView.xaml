<UserControl x:Class="WpfNavigationProject.Views.MotosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:WpfNavigationProject.Views"
             mc:Ignorable="d"
             d:DesignHeight="450"
             d:DesignWidth="800"
             Background="Transparent">

    <UserControl.Resources>

        <!-- Sombra estándar -->
        <DropShadowEffect x:Key="ShadowDepth3"
                          Color="Black"
                          Direction="270"
                          ShadowDepth="3"
                          BlurRadius="5"
                          Opacity="0.1"/>

    </UserControl.Resources>


    <Border Background="White"
            CornerRadius="15"
            Padding="30"
            Effect="{StaticResource ShadowDepth3}">

        <Grid>

            <Grid.RowDefinitions>

                <!-- Título -->
                <RowDefinition Height="Auto"/>

                <!-- Filtros -->
                <RowDefinition Height="Auto"/>

                <!-- Tabla -->
                <RowDefinition Height="*"/>

                <!-- Paginación -->
                <RowDefinition Height="Auto"/>

                <!-- Botón -->
                <RowDefinition Height="Auto"/>

            </Grid.RowDefinitions>


            <!-- ===================================================== -->
            <!-- TÍTULO -->
            <!-- ===================================================== -->

            <TextBlock Grid.Row="0"
                       Text="Listado de Motos"
                       FontSize="36"
                       FontWeight="Bold"
                       Foreground="#333333"
                       Margin="0,0,0,15"
                       TextAlignment="Center"/>


            <!-- ===================================================== -->
            <!-- PANEL DE FILTROS -->
            <!-- ===================================================== -->

            <Border Grid.Row="1"
                    Background="#F5F7FA"
                    CornerRadius="10"
                    Padding="15"
                    Margin="0,0,0,15">

                <Grid>

                    <Grid.ColumnDefinitions>

                        <!-- Buscar -->
                        <ColumnDefinition Width="2.1*"/>

                        <!-- Campo -->
                        <ColumnDefinition Width="1.2*"/>

                        <!-- Fecha desde -->
                        <ColumnDefinition Width="1.25*"/>

                        <!-- Fecha hasta -->
                        <ColumnDefinition Width="1.25*"/>

                        <!-- Botón -->
                        <ColumnDefinition Width="Auto"/>

                    </Grid.ColumnDefinitions>


                    <!-- ================================================= -->
                    <!-- BUSCAR -->
                    <!-- ================================================= -->

                    <StackPanel Grid.Column="0"
                                Margin="0,0,10,0">

                        <TextBlock Text="Buscar"
                                   FontWeight="SemiBold"
                                   Foreground="#444444"
                                   Margin="0,0,0,5"/>

                        <TextBox x:Name="TxtBuscar"
                                 Height="32"
                                 Padding="8,4"
                                 VerticalContentAlignment="Center"
                                 TextChanged="TxtBuscar_TextChanged"/>

                    </StackPanel>


                    <!-- ================================================= -->
                    <!-- CAMPO DE BÚSQUEDA -->
                    <!-- ================================================= -->

                    <StackPanel Grid.Column="1"
                                Margin="0,0,10,0">

                        <TextBlock Text="Buscar por"
                                   FontWeight="SemiBold"
                                   Foreground="#444444"
                                   Margin="0,0,0,5"/>

                        <ComboBox x:Name="CmbCampoBusqueda"
                                  Height="32"
                                  SelectedIndex="0"
                                  SelectionChanged="Filtro_Changed">

                            <ComboBoxItem Content="Cliente"/>

                            <ComboBoxItem Content="Marca"/>

                            <ComboBoxItem Content="Modelo"/>

                            <ComboBoxItem Content="Patente"/>

                        </ComboBox>

                    </StackPanel>


                    <!-- ================================================= -->
                    <!-- FECHA DESDE -->
                    <!-- ================================================= -->

                    <StackPanel Grid.Column="2"
                                Margin="0,0,10,0">

                        <TextBlock Text="Alta desde"
                                   FontWeight="SemiBold"
                                   Foreground="#444444"
                                   Margin="0,0,0,5"/>

                        <DatePicker x:Name="DpFechaDesde"
                                    Height="32"
                                    SelectedDateChanged="Filtro_Changed"/>

                    </StackPanel>


                    <!-- ================================================= -->
                    <!-- FECHA HASTA -->
                    <!-- ================================================= -->

                    <StackPanel Grid.Column="3"
                                Margin="0,0,10,0">

                        <TextBlock Text="Alta hasta"
                                   FontWeight="SemiBold"
                                   Foreground="#444444"
                                   Margin="0,0,0,5"/>

                        <DatePicker x:Name="DpFechaHasta"
                                    Height="32"
                                    SelectedDateChanged="Filtro_Changed"/>

                    </StackPanel>


                    <!-- ================================================= -->
                    <!-- BOTÓN LIMPIAR -->
                    <!-- ================================================= -->

                    <Button Grid.Column="4"
                            Content="🧹 Limpiar"
                            Height="32"
                            Width="100"
                            VerticalAlignment="Bottom"
                            Click="BtnLimpiarFiltros_Click"
                            Style="{StaticResource AccionButtonStyle}"/>

                </Grid>

            </Border>


            <!-- ===================================================== -->
            <!-- TABLA DE MOTOS -->
            <!-- ===================================================== -->

            <DataGrid Grid.Row="2"
                      Name="MotosDataGrid"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      SelectionMode="Single"
                      GridLinesVisibility="Horizontal"
                      RowBackground="LightGray"
                      AlternatingRowBackground="#FFEFEFEF"
                      CanUserResizeColumns="True"
                      Foreground="#FF2A2A2A"
                      FontSize="14"
                      FontWeight="SemiBold"
                      HeadersVisibility="Column">

                <DataGrid.ColumnHeaderStyle>

                    <Style TargetType="{x:Type DataGridColumnHeader}">

                        <Setter Property="Background"
                                Value="#FF007ACC"/>

                        <Setter Property="Foreground"
                                Value="White"/>

                        <Setter Property="HorizontalContentAlignment"
                                Value="Center"/>

                        <Setter Property="Padding"
                                Value="5"/>

                    </Style>

                </DataGrid.ColumnHeaderStyle>


                <DataGrid.Columns>


                    <!-- ================================================= -->
                    <!-- CLIENTE -->
                    <!-- ================================================= -->

                    <DataGridTextColumn Header="Cliente"
                                        Binding="{Binding NombreCliente}"
                                        Width="1.5*"/>


                    <!-- ================================================= -->
                    <!-- MARCA -->
                    <!-- ================================================= -->

                    <DataGridTextColumn Header="Marca"
                                        Binding="{Binding Marca}"
                                        Width="1.1*"/>


                    <!-- ================================================= -->
                    <!-- MODELO -->
                    <!-- ================================================= -->

                    <DataGridTextColumn Header="Modelo"
                                        Binding="{Binding Modelo}"
                                        Width="1.2*"/>


                    <!-- ================================================= -->
                    <!-- FECHA DE ALTA -->
                    <!-- ================================================= -->

                    <DataGridTextColumn Header="Fecha Alta"
                                        Binding="{Binding FechaAlta, StringFormat={}{0:dd/MM/yyyy}}"
                                        Width="110">

                        <DataGridTextColumn.ElementStyle>

                            <Style TargetType="TextBlock">

                                <Setter Property="HorizontalAlignment"
                                        Value="Center"/>

                            </Style>

                        </DataGridTextColumn.ElementStyle>

                    </DataGridTextColumn>


                    <!-- ================================================= -->
                    <!-- OBSERVACIONES -->
                    <!-- ================================================= -->

                    <DataGridTextColumn Header="Observaciones"
                                        Binding="{Binding Observaciones}"
                                        Width="2.2*"/>


                    <!-- ================================================= -->
                    <!-- EDITAR -->
                    <!-- ================================================= -->

                    <DataGridTemplateColumn Header="Editar"
                                            Width="110">

                        <DataGridTemplateColumn.CellTemplate>

                            <DataTemplate>

                                <Button Content="✏️ Editar"
                                        Click="BtnEditar_Click"
                                        Margin="2"
                                        Tag="{Binding IdMoto}"
                                        Style="{StaticResource AccionButtonStyle}"/>

                            </DataTemplate>

                        </DataGridTemplateColumn.CellTemplate>

                    </DataGridTemplateColumn>


                </DataGrid.Columns>

            </DataGrid>


            <!-- ===================================================== -->
            <!-- PAGINACIÓN -->
            <!-- ===================================================== -->

            <StackPanel Grid.Row="3"
                        Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Margin="0,15,0,0">

                <Button x:Name="BtnPaginaAnterior"
                        Content="◀ Anterior"
                        Width="100"
                        Height="32"
                        Margin="0,0,10,0"
                        Click="BtnPaginaAnterior_Click"
                        Style="{StaticResource AccionButtonStyle}"/>

                <TextBlock x:Name="TxtPaginaActual"
                           Text="Página 1 de 1"
                           VerticalAlignment="Center"
                           FontWeight="SemiBold"
                           Foreground="#444444"
                           Margin="5,0"/>

                <Button x:Name="BtnPaginaSiguiente"
                        Content="Siguiente ▶"
                        Width="100"
                        Height="32"
                        Margin="10,0,0,0"
                        Click="BtnPaginaSiguiente_Click"
                        Style="{StaticResource AccionButtonStyle}"/>

            </StackPanel>


            <!-- ===================================================== -->
            <!-- NUEVA MOTO -->
            <!-- ===================================================== -->

            <Button Grid.Row="4"
                    Content="+ Nueva Moto"
                    Name="BtnNuevaMoto"
                    Click="BtnNuevaMoto_Click"
                    Style="{StaticResource AccionButtonStyle}"
                    Margin="0,20,0,0"
                    HorizontalAlignment="Center"
                    Width="180"
                    Height="35"/>

        </Grid>

    </Border>

</UserControl>