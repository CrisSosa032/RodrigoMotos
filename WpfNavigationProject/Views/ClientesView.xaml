<UserControl x:Class="WpfNavigationProject.Views.ClientesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:WpfNavigationProject.Views"
             mc:Ignorable="d"
             d:DesignHeight="700"
             d:DesignWidth="1000"
             Background="Transparent">

    <UserControl.Resources>

        <DropShadowEffect x:Key="ShadowDepth3"
                          Color="Black"
                          Direction="270"
                          ShadowDepth="3"
                          BlurRadius="5"
                          Opacity="0.1"/>

    </UserControl.Resources>


    <Border Background="White"
            CornerRadius="15"
            Padding="30"
            Effect="{StaticResource ShadowDepth3}">

        <Grid>

            <Grid.RowDefinitions>

                <!-- Título -->
                <RowDefinition Height="Auto"/>

                <!-- Buscador -->
                <RowDefinition Height="Auto"/>

                <!-- Espacio -->
                <RowDefinition Height="15"/>

                <!-- Tabla -->
                <RowDefinition Height="*"/>

                <!-- Botón -->
                <RowDefinition Height="Auto"/>

            </Grid.RowDefinitions>


            <!-- ================================================= -->
            <!-- TÍTULO -->
            <!-- ================================================= -->

            <TextBlock Grid.Row="0"
                       Text="Listado de Clientes"
                       FontSize="36"
                       FontWeight="Bold"
                       Foreground="#333333"
                       Margin="0,0,0,15"
                       TextAlignment="Center"/>


            <!-- ================================================= -->
            <!-- BUSCADOR -->
            <!-- ================================================= -->

            <Border Grid.Row="1"
                    Background="#F7F8FA"
                    CornerRadius="10"
                    Padding="15"
                    BorderBrush="#E5E7EB"
                    BorderThickness="1">

                <Grid>

                    <Grid.RowDefinitions>

                        <!-- Búsqueda -->
                        <RowDefinition Height="Auto"/>

                        <!-- Estado -->
                        <RowDefinition Height="Auto"/>

                        <!-- Fechas -->
                        <RowDefinition Height="Auto"/>

                    </Grid.RowDefinitions>


                    <!-- ================================ -->
                    <!-- BÚSQUEDA -->
                    <!-- ================================ -->

                    <Grid Grid.Row="0">

                        <Grid.ColumnDefinitions>

                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="180"/>

                        </Grid.ColumnDefinitions>


                        <!-- Caja de búsqueda -->

                        <TextBox x:Name="TxtBuscar"
                                 Grid.Column="0"
                                 Height="38"
                                 Padding="10"
                                 FontSize="14"
                                 VerticalContentAlignment="Center"
                                 TextChanged="TxtBuscar_TextChanged"/>


                        <!-- Selector -->

                        <ComboBox x:Name="CmbBuscarPor"
                                  Grid.Column="1"
                                  Height="38"
                                  Margin="10,0,0,0"
                                  FontSize="14"
                                  VerticalContentAlignment="Center"
                                  SelectionChanged="CmbBuscarPor_SelectionChanged">

                            <ComboBoxItem Content="Nombre"
                                          IsSelected="True"/>

                            <ComboBoxItem Content="DNI"/>

                        </ComboBox>

                    </Grid>


                    <!-- ================================ -->
                    <!-- ESTADO -->
                    <!-- ================================ -->

                    <StackPanel Grid.Row="1"
                                Orientation="Horizontal"
                                Margin="0,15,0,0">

                        <TextBlock Text="Estado:"
                                   FontWeight="SemiBold"
                                   FontSize="14"
                                   VerticalAlignment="Center"
                                   Margin="0,0,15,0"/>

                        <RadioButton x:Name="RbActivos"
                                     Content="Activos"
                                     IsChecked="True"
                                     GroupName="EstadoClientes"
                                     Margin="0,0,15,0"
                                     VerticalAlignment="Center"
                                     Checked="FiltroCambiado"/>

                        <RadioButton x:Name="RbInactivos"
                                     Content="Inactivos"
                                     GroupName="EstadoClientes"
                                     Margin="0,0,15,0"
                                     VerticalAlignment="Center"
                                     Checked="FiltroCambiado"/>

                        <RadioButton x:Name="RbTodos"
                                     Content="Todos"
                                     GroupName="EstadoClientes"
                                     VerticalAlignment="Center"
                                     Checked="FiltroCambiado"/>

                    </StackPanel>


                    <!-- ================================ -->
                    <!-- FECHAS -->
                    <!-- ================================ -->

                    <Grid Grid.Row="2"
                          Margin="0,15,0,0">

                        <Grid.ColumnDefinitions>

                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="180"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="180"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>

                        </Grid.ColumnDefinitions>


                        <TextBlock Grid.Column="0"
                                   Text="Fecha de ingreso:"
                                   FontWeight="SemiBold"
                                   FontSize="14"
                                   VerticalAlignment="Center"
                                   Margin="0,0,10,0"/>


                        <DatePicker x:Name="DpFechaDesde"
                                    Grid.Column="1"
                                    Height="35"
                                    SelectedDateChanged="Fecha_SelectedDateChanged"/>


                        <TextBlock Grid.Column="2"
                                   Text="Hasta:"
                                   FontWeight="SemiBold"
                                   FontSize="14"
                                   VerticalAlignment="Center"
                                   Margin="15,0,10,0"/>


                        <DatePicker x:Name="DpFechaHasta"
                                    Grid.Column="3"
                                    Height="35"
                                    SelectedDateChanged="Fecha_SelectedDateChanged"/>


                        <Button Grid.Column="5"
                                Content="✖ Limpiar filtros"
                                Height="35"
                                Width="140"
                                Click="BtnLimpiarFiltros_Click"
                                Style="{StaticResource AccionButtonStyle}"/>

                    </Grid>

                </Grid>

            </Border>


            <!-- ================================================= -->
            <!-- TABLA -->
            <!-- ================================================= -->

            <DataGrid Grid.Row="3"
                      Name="ClientesDataGrid"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      SelectionMode="Single"
                      GridLinesVisibility="Horizontal"
                      RowBackground="LightGray"
                      AlternatingRowBackground="#FFEFEFEF"
                      CanUserResizeColumns="True"
                      Foreground="#FF2A2A2A"
                      FontSize="14"
                      FontWeight="SemiBold"
                      HeadersVisibility="Column">

                <DataGrid.ColumnHeaderStyle>

                    <Style TargetType="{x:Type DataGridColumnHeader}">

                        <Setter Property="Background"
                                Value="#FF007ACC"/>

                        <Setter Property="Foreground"
                                Value="White"/>

                        <Setter Property="HorizontalContentAlignment"
                                Value="Center"/>

                        <Setter Property="Padding"
                                Value="5"/>

                    </Style>

                </DataGrid.ColumnHeaderStyle>


                <DataGrid.Columns>

                    
                    <DataGridTextColumn Header="Nombre"
                                        Binding="{Binding Nombre}"
                                        Width="*"/>


                    <DataGridTextColumn Header="DNI"
                                        Binding="{Binding DNI}"
                                        Width="120">

                        <DataGridTextColumn.ElementStyle>

                            <Style TargetType="TextBlock">

                                <Setter Property="HorizontalAlignment"
                                        Value="Center"/>

                            </Style>

                        </DataGridTextColumn.ElementStyle>

                    </DataGridTextColumn>


                    <DataGridTextColumn Header="Teléfono"
                                        Binding="{Binding Telefono}"
                                        Width="120">

                        <DataGridTextColumn.ElementStyle>

                            <Style TargetType="TextBlock">

                                <Setter Property="HorizontalAlignment"
                                        Value="Center"/>

                            </Style>

                        </DataGridTextColumn.ElementStyle>

                    </DataGridTextColumn>


                    <DataGridTextColumn Header="Dirección"
                                        Binding="{Binding Direccion}"
                                        Width="*"/>


                    <DataGridTextColumn Header="Fecha ingreso"
                                        Binding="{Binding FechaIngreso,
                                                  StringFormat={}{0:dd/MM/yyyy}}"
                                        Width="120">

                        <DataGridTextColumn.ElementStyle>

                            <Style TargetType="TextBlock">

                                <Setter Property="HorizontalAlignment"
                                        Value="Center"/>

                            </Style>

                        </DataGridTextColumn.ElementStyle>

                    </DataGridTextColumn>


                    <!-- ================================ -->
                    <!-- ESTADO -->
                    <!-- ================================ -->

                    <DataGridTemplateColumn Header="Estado"
                                            Width="100">

                        <DataGridTemplateColumn.CellTemplate>

                            <DataTemplate>

                                <TextBlock HorizontalAlignment="Center"
                                           VerticalAlignment="Center">

                                    <TextBlock.Style>

                                        <Style TargetType="TextBlock">

                                            <Setter Property="Text"
                                                    Value="Activo"/>

                                            <Setter Property="Foreground"
                                                    Value="Green"/>

                                            <Style.Triggers>

                                                <DataTrigger Binding="{Binding Activo}"
                                                             Value="False">

                                                    <Setter Property="Text"
                                                            Value="Inactivo"/>

                                                    <Setter Property="Foreground"
                                                            Value="Red"/>

                                                </DataTrigger>

                                            </Style.Triggers>

                                        </Style>

                                    </TextBlock.Style>

                                </TextBlock>

                            </DataTemplate>

                        </DataGridTemplateColumn.CellTemplate>

                    </DataGridTemplateColumn>


                    <!-- ==================== ACCIONES ==================== -->
                    <DataGridTemplateColumn Header="Acciones"
                        Width="150">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>

                                <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Center">

                                    <!-- EDITAR -->
                                    <Button Content="✏️"
                                        Click="BtnEditar_Click"
                                        Tag="{Binding IdCliente}"
                                        Width="42"
                                        Height="24"
                                        Margin="2"
                                        Padding="0"
                                        ToolTip="Editar cliente"
                                        Style="{StaticResource AccionButtonStyle}"/>

                                    <!-- DESACTIVAR -->
                                    <Button Content="🗑️"
                                        Click="BtnEliminar_Click"
                                        Tag="{Binding IdCliente}"
                                        Width="42"
                                        Height="24"
                                        Margin="2"
                                        Padding="0"
                                        ToolTip="Desactivar cliente">

                                        <Button.Style>
                                            <Style TargetType="Button"
                                            BasedOn="{StaticResource PeligroButtonStyle}">

                                                <Setter Property="Visibility"
                                                    Value="Visible"/>

                                                <Style.Triggers>

                                                    <DataTrigger Binding="{Binding Activo}"
                                                        Value="False">

                                                        <Setter Property="Visibility"
                                                        Value="Collapsed"/>

                                                    </DataTrigger>

                                                </Style.Triggers>

                                            </Style>
                                        </Button.Style>

                                    </Button>

                                    <!-- ACTIVAR -->
                                    <Button Content="🔄"
                                        Click="BtnActivar_Click"
                                        Tag="{Binding IdCliente}"
                                        Width="42"
                                        Height="24"
                                        Margin="2"
                                        Padding="0"
                                        ToolTip="Activar cliente">

                                        <Button.Style>
                                            <Style TargetType="Button"
                                                BasedOn="{StaticResource ExitoButtonStyle}">

                                                <Setter Property="Visibility"
                                                Value="Collapsed"/>

                                                <Style.Triggers>

                                                    <DataTrigger Binding="{Binding Activo}"
                                                        Value="False">

                                                        <Setter Property="Visibility"
                                                        Value="Visible"/>

                                                    </DataTrigger>

                                                </Style.Triggers>

                                            </Style>
                                        </Button.Style>

                                    </Button>

                                </StackPanel>

                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                </DataGrid.Columns>

            </DataGrid>


            <!-- ================================================= -->
            <!-- NUEVO CLIENTE -->
            <!-- ================================================= -->

            <Button Grid.Row="4"
                    Content="+ Nuevo Cliente"
                    Name="BtnNuevoCliente"
                    Click="BtnNuevoCliente_Click"
                    Style="{StaticResource AccionButtonStyle}"
                    Margin="0,20,0,0"
                    HorizontalAlignment="Center"
                    Width="180"
                    Height="35"/>

        </Grid>

    </Border>

</UserControl>