<UserControl x:Class="WpfNavigationProject.Views.ClientesView"
       xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
       xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
       xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
       xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
       xmlns:local="clr-namespace:WpfNavigationProject.Views"
       mc:Ignorable="d"
       d:DesignHeight="700"
       d:DesignWidth="1000"
       Background="Transparent">

    <UserControl.Resources>

        <DropShadowEffect x:Key="ShadowDepth3"
                      Color="Black"
                      Direction="270"
                      ShadowDepth="3"
                      BlurRadius="5"
                      Opacity="0.1"/>

    </UserControl.Resources>


    <Border Background="White"
        CornerRadius="15"
        Padding="30"
        Effect="{StaticResource ShadowDepth3}">

        <Grid>

            <Grid.RowDefinitions>

                <!-- Título -->
                <RowDefinition Height="Auto"/>

                <!-- Filtros -->
                <RowDefinition Height="Auto"/>

                <!-- Espacio -->
                <RowDefinition Height="15"/>

                <!-- Tabla -->
                <RowDefinition Height="*"/>

                <!-- Paginado -->
                <RowDefinition Height="Auto"/>

                <!-- Botón Nuevo Cliente -->
                <RowDefinition Height="Auto"/>

            </Grid.RowDefinitions>


            <!-- ================================================= -->
            <!-- TÍTULO -->
            <!-- ================================================= -->

            <TextBlock Grid.Row="0"
                   Text="Listado de Clientes"
                   FontSize="36"
                   FontWeight="Bold"
                   Foreground="#333333"
                   Margin="0,0,0,15"
                   TextAlignment="Center"/>


            <!-- ================================================= -->
            <!-- PANEL DE FILTROS -->
            <!-- ================================================= -->

            <Border Grid.Row="1"
                Background="#F7F8FA"
                CornerRadius="10"
                Padding="15"
                BorderBrush="#E5E7EB"
                BorderThickness="1"
                Margin="0,0,0,15">

                <Grid>

                    <Grid.RowDefinitions>

                        <!-- Primera fila: búsqueda + botón -->
                        <RowDefinition Height="Auto"/>

                        <!-- Segunda fila: estado + fechas -->
                        <RowDefinition Height="Auto"/>

                    </Grid.RowDefinitions>


                    <!-- ================================================= -->
                    <!-- PRIMERA FILA -->
                    <!-- BUSCAR + BUSCAR POR + LIMPIAR -->
                    <!-- ================================================= -->

                    <Grid Grid.Row="0"
                      Margin="0,0,0,12">

                        <Grid.ColumnDefinitions>

                            <!-- Buscar -->
                            <ColumnDefinition Width="1.7*"/>

                            <!-- Campo -->
                            <ColumnDefinition Width="1.1*"/>

                            <!-- Espacio -->
                            <ColumnDefinition Width="20"/>

                            <!-- Botón -->
                            <ColumnDefinition Width="Auto"/>

                        </Grid.ColumnDefinitions>


                        <!-- ============================= -->
                        <!-- BUSCAR -->
                        <!-- ============================= -->

                        <StackPanel Grid.Column="0"
                                Margin="0,0,10,0">

                            <TextBlock Text="Buscar"
                                   FontWeight="SemiBold"
                                   Foreground="#444444"
                                   Margin="0,0,0,5"/>

                            <TextBox x:Name="TxtBuscar"
                                 Height="32"
                                 Padding="8,4"
                                 VerticalContentAlignment="Center"
                                 TextChanged="TxtBuscar_TextChanged"/>

                        </StackPanel>


                        <!-- ============================= -->
                        <!-- BUSCAR POR -->
                        <!-- ============================= -->

                        <StackPanel Grid.Column="1">

                            <TextBlock Text="Buscar por"
                                   FontWeight="SemiBold"
                                   Foreground="#444444"
                                   Margin="0,0,0,5"/>

                            <ComboBox x:Name="CmbBuscarPor"
                                  Height="32"
                                  SelectedIndex="0"
                                  SelectionChanged="CmbBuscarPor_SelectionChanged">

                                <ComboBoxItem Content="Nombre"
                                          IsSelected="True"/>

                                <ComboBoxItem Content="DNI"/>

                            </ComboBox>

                        </StackPanel>


                        <!-- ============================= -->
                        <!-- BOTÓN LIMPIAR -->
                        <!-- ============================= -->

                        <Button Grid.Column="3"
                            Content="✖ Limpiar filtros"
                            Height="32"
                            Width="140"
                            VerticalAlignment="Bottom"
                            Click="BtnLimpiarFiltros_Click"
                            Style="{StaticResource AccionButtonStyle}"/>

                    </Grid>


                    <!-- ================================================= -->
                    <!-- SEGUNDA FILA -->
                    <!-- ESTADO + FECHAS -->
                    <!-- ================================================= -->

                    <Grid Grid.Row="1">

                        <Grid.ColumnDefinitions>

                            <!-- Estado -->
                            <ColumnDefinition Width="2.7*"/>

                            <!-- Fecha desde -->
                            <ColumnDefinition Width="1.3*"/>

                            <!-- Fecha hasta -->
                            <ColumnDefinition Width="1.3*"/>

                        </Grid.ColumnDefinitions>


                        <!-- ================================================= -->
                        <!-- ESTADO -->
                        <!-- ================================================= -->

                        <StackPanel Grid.Column="0"
                                Margin="0,0,20,0">

                            <TextBlock Text="Estado"
                                   FontWeight="SemiBold"
                                   Foreground="#444444"
                                   Margin="0,0,0,5"/>

                            <StackPanel Orientation="Horizontal"
                                    VerticalAlignment="Center">

                                <RadioButton x:Name="RbActivos"
                                         Content="Activos"
                                         GroupName="EstadoClientes"
                                         Margin="0,0,18,0"
                                         IsChecked="True"
                                         Checked="FiltroCambiado"/>

                                <RadioButton x:Name="RbInactivos"
                                         Content="Inactivos"
                                         GroupName="EstadoClientes"
                                         Margin="0,0,18,0"
                                         Checked="FiltroCambiado"/>

                                <RadioButton x:Name="RbTodos"
                                         Content="Todos"
                                         GroupName="EstadoClientes"
                                         Checked="FiltroCambiado"/>

                            </StackPanel>

                        </StackPanel>


                        <!-- ================================================= -->
                        <!-- FECHA DESDE -->
                        <!-- ================================================= -->

                        <StackPanel Grid.Column="1"
                                Margin="0,0,15,0">

                            <TextBlock Text="Fecha de ingreso"
                                   FontWeight="SemiBold"
                                   Foreground="#444444"
                                   Margin="0,0,0,5"/>

                            <DatePicker x:Name="DpFechaDesde"
                                    Height="32"
                                    SelectedDateChanged="Fecha_SelectedDateChanged"/>

                        </StackPanel>


                        <!-- ================================================= -->
                        <!-- FECHA HASTA -->
                        <!-- ================================================= -->

                        <StackPanel Grid.Column="2">

                            <TextBlock Text="Fecha hasta"
                                   FontWeight="SemiBold"
                                   Foreground="#444444"
                                   Margin="0,0,0,5"/>

                            <DatePicker x:Name="DpFechaHasta"
                                    Height="32"
                                    SelectedDateChanged="Fecha_SelectedDateChanged"/>

                        </StackPanel>

                    </Grid>

                </Grid>

            </Border>


            <!-- ================================================= -->
            <!-- TABLA -->
            <!-- ================================================= -->

            <DataGrid Grid.Row="3"
                  Name="ClientesDataGrid"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  SelectionMode="Single"
                  GridLinesVisibility="Horizontal"
                  RowBackground="LightGray"
                  AlternatingRowBackground="#FFEFEFEF"
                  CanUserResizeColumns="True"
                  Foreground="#FF2A2A2A"
                  FontSize="14"
                  FontWeight="SemiBold"
                  HeadersVisibility="Column">

                <DataGrid.ColumnHeaderStyle>

                    <Style TargetType="{x:Type DataGridColumnHeader}">

                        <Setter Property="Background"
                            Value="#FF007ACC"/>

                        <Setter Property="Foreground"
                            Value="White"/>

                        <Setter Property="HorizontalContentAlignment"
                            Value="Center"/>

                        <Setter Property="Padding"
                            Value="5"/>

                    </Style>

                </DataGrid.ColumnHeaderStyle>


                <DataGrid.Columns>


                    <!-- NOMBRE -->

                    <DataGridTextColumn Header="Nombre"
                                    Binding="{Binding Nombre}"
                                    Width="*"/>


                    <!-- DNI -->

                    <DataGridTextColumn Header="DNI"
                                    Binding="{Binding DNI}"
                                    Width="120">

                        <DataGridTextColumn.ElementStyle>

                            <Style TargetType="TextBlock">

                                <Setter Property="HorizontalAlignment"
                                    Value="Center"/>

                            </Style>

                        </DataGridTextColumn.ElementStyle>

                    </DataGridTextColumn>


                    <!-- TELÉFONO -->

                    <DataGridTextColumn Header="Teléfono"
                                    Binding="{Binding Telefono}"
                                    Width="120">

                        <DataGridTextColumn.ElementStyle>

                            <Style TargetType="TextBlock">

                                <Setter Property="HorizontalAlignment"
                                    Value="Center"/>

                            </Style>

                        </DataGridTextColumn.ElementStyle>

                    </DataGridTextColumn>


                    <!-- DIRECCIÓN -->

                    <DataGridTextColumn Header="Dirección"
                                    Binding="{Binding Direccion}"
                                    Width="*"/>


                    <!-- FECHA INGRESO -->

                    <DataGridTextColumn Header="Fecha ingreso"
                                    Binding="{Binding FechaIngreso,
                                              StringFormat={}{0:dd/MM/yyyy}}"
                                    Width="120">

                        <DataGridTextColumn.ElementStyle>

                            <Style TargetType="TextBlock">

                                <Setter Property="HorizontalAlignment"
                                    Value="Center"/>

                            </Style>

                        </DataGridTextColumn.ElementStyle>

                    </DataGridTextColumn>


                    <!-- ESTADO -->

                    <DataGridTemplateColumn Header="Estado"
                                        Width="100">

                        <DataGridTemplateColumn.CellTemplate>

                            <DataTemplate>

                                <TextBlock HorizontalAlignment="Center"
                                       VerticalAlignment="Center">

                                    <TextBlock.Style>

                                        <Style TargetType="TextBlock">

                                            <Setter Property="Text"
                                                Value="Activo"/>

                                            <Setter Property="Foreground"
                                                Value="Green"/>

                                            <Style.Triggers>

                                                <DataTrigger Binding="{Binding Activo}"
                                                         Value="False">

                                                    <Setter Property="Text"
                                                        Value="Inactivo"/>

                                                    <Setter Property="Foreground"
                                                        Value="Red"/>

                                                </DataTrigger>

                                            </Style.Triggers>

                                        </Style>

                                    </TextBlock.Style>

                                </TextBlock>

                            </DataTemplate>

                        </DataGridTemplateColumn.CellTemplate>

                    </DataGridTemplateColumn>


                    <!-- ==================== ACCIONES ==================== -->

                    <DataGridTemplateColumn Header="Acciones"
                                        Width="150">

                        <DataGridTemplateColumn.CellTemplate>

                            <DataTemplate>

                                <StackPanel Orientation="Horizontal"
                                        HorizontalAlignment="Center">

                                    <!-- EDITAR -->

                                    <Button Content="✏️"
                                        Click="BtnEditar_Click"
                                        Tag="{Binding IdCliente}"
                                        Width="42"
                                        Height="24"
                                        Margin="2"
                                        Padding="0"
                                        ToolTip="Editar cliente"
                                        Style="{StaticResource AccionButtonStyle}"/>


                                    <!-- DESACTIVAR -->

                                    <Button Content="🗑️"
                                        Click="BtnEliminar_Click"
                                        Tag="{Binding IdCliente}"
                                        Width="42"
                                        Height="24"
                                        Margin="2"
                                        Padding="0"
                                        ToolTip="Desactivar cliente">

                                        <Button.Style>

                                            <Style TargetType="Button"
                                               BasedOn="{StaticResource PeligroButtonStyle}">

                                                <Setter Property="Visibility"
                                                    Value="Visible"/>

                                                <Style.Triggers>

                                                    <DataTrigger Binding="{Binding Activo}"
                                                             Value="False">

                                                        <Setter Property="Visibility"
                                                            Value="Collapsed"/>

                                                    </DataTrigger>

                                                </Style.Triggers>

                                            </Style>

                                        </Button.Style>

                                    </Button>


                                    <!-- ACTIVAR -->

                                    <Button Content="🔄"
                                        Click="BtnActivar_Click"
                                        Tag="{Binding IdCliente}"
                                        Width="42"
                                        Height="24"
                                        Margin="2"
                                        Padding="0"
                                        ToolTip="Activar cliente">

                                        <Button.Style>

                                            <Style TargetType="Button"
                                               BasedOn="{StaticResource ExitoButtonStyle}">

                                                <Setter Property="Visibility"
                                                    Value="Collapsed"/>

                                                <Style.Triggers>

                                                    <DataTrigger Binding="{Binding Activo}"
                                                             Value="False">

                                                        <Setter Property="Visibility"
                                                            Value="Visible"/>

                                                    </DataTrigger>

                                                </Style.Triggers>

                                            </Style>

                                        </Button.Style>

                                    </Button>

                                </StackPanel>

                            </DataTemplate>

                        </DataGridTemplateColumn.CellTemplate>

                    </DataGridTemplateColumn>

                </DataGrid.Columns>

            </DataGrid>


            <!-- ================================================= -->
            <!-- PAGINADO -->
            <!-- ================================================= -->

            <Grid Grid.Row="4"
              Margin="0,15,0,0">

                <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">

                    <Button x:Name="BtnPaginaAnterior"
                        Content="‹ Anterior"
                        Width="100"
                        Height="32"
                        Margin="5,0"
                        Click="BtnPaginaAnterior_Click"
                        Style="{StaticResource AccionButtonStyle}"/>

                    <TextBlock x:Name="TxtPaginaActual"
                           Text="Página 1 de 1"
                           FontSize="14"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Center"
                           Margin="15,0"/>

                    <Button x:Name="BtnPaginaSiguiente"
                        Content="Siguiente ›"
                        Width="100"
                        Height="32"
                        Margin="5,0"
                        Click="BtnPaginaSiguiente_Click"
                        Style="{StaticResource AccionButtonStyle}"/>

                </StackPanel>

            </Grid>


            <!-- ================================================= -->
            <!-- NUEVO CLIENTE -->
            <!-- ================================================= -->

            <Button Grid.Row="5"
                Content="+ Nuevo Cliente"
                Name="BtnNuevoCliente"
                Click="BtnNuevoCliente_Click"
                Style="{StaticResource AccionButtonStyle}"
                Margin="0,15,0,0"
                HorizontalAlignment="Center"
                Width="180"
                Height="35"/>

        </Grid>

    </Border>

</UserControl>
