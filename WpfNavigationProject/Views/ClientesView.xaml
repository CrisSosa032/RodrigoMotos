<UserControl x:Class="WpfNavigationProject.Views.ClientesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:WpfNavigationProject.Views"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    
    <Border Background="White" CornerRadius="15" Padding="30" Effect="{StaticResource ShadowDepth3}">
        <StackPanel>
            <TextBlock Text="Listado de Clientes" 
                       FontSize="36" 
                       FontWeight="Bold" 
                       Foreground="#333333" 
                       Margin="0,0,0,15"
                       TextAlignment="Center"/>

            <DataGrid
                Name="ClientesDataGrid"
                AutoGenerateColumns="False"  
                IsReadOnly="True"
                SelectionMode="Single"  
                GridLinesVisibility="Horizontal"  
                RowBackground="LightGray"
                AlternatingRowBackground="#FFEFEFEF" 
                CanUserResizeColumns="True"    
                Foreground="#FF2A2A2A" FontSize="14"
                FontWeight="SemiBold"
                HeadersVisibility="Column"
                MaxHeight="250">

                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="{x:Type DataGridColumnHeader}">
                        <Setter Property="Background" Value="#FF007ACC"/>
                        <Setter Property="Foreground" Value="White"/>
                        <Setter Property="HorizontalContentAlignment" Value="Center"/>
                    </Style>
                </DataGrid.ColumnHeaderStyle>



                <DataGrid.Columns>
                    <DataGridTextColumn 
                        Header="ID Cliente" 
                        Binding="{Binding IdCliente}" 
                        IsReadOnly="True" 
                        Width="77" />

                    <DataGridTextColumn 
                        Header="Nombre" 
                        Binding="{Binding Nombre}" 
                        Width="150" />

                    <DataGridTextColumn 
                        Header="DNI" 
                        Binding="{Binding DNI}" 
                        Width="120" >

                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Center"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <DataGridTextColumn 
                        Header="Teléfono" 
                        Binding="{Binding Telefono}" 
                        Width="120">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Center"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <DataGridTextColumn 
                        Header="Dirección" 
                        Binding="{Binding Direccion}" 
                        Width="150"/>

                    <DataGridTemplateColumn Header="Acciones" Width="*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <Button Content="✏️ Editar" 
                        Click="BtnEditar_Click" 
                        Margin="2" 
                        Tag="{Binding IdCliente}" 
                        Style="{StaticResource AccionButtonStyle}"/>

                                    <Button Content="🗑️ Eliminar" 
                        Click="BtnEliminar_Click" 
                        Margin="2" 
                        Tag="{Binding IdCliente}" 
                        Style="{StaticResource PeligroButtonStyle}"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                </DataGrid.Columns>
            </DataGrid>

            <Button Content="+ Nuevo Cliente" 
                Name="BtnNuevoCliente" 
                Click="BtnNuevoCliente_Click" 
                Style="{StaticResource AccionButtonStyle}" 
                Margin="0, 20, 0, 0"
                HorizontalAlignment="Center"
                Width="180"
                Height="35"/>


        </StackPanel>
    </Border>

    <UserControl.Resources>
        <!-- Definición de una sombra simple para embellecer la vista -->
        <DropShadowEffect x:Key="ShadowDepth3" 
                          Color="Black" 
                          Direction="270" 
                          ShadowDepth="3" 
                          BlurRadius="5" 
                          Opacity="0.1"/>
    </UserControl.Resources>
</UserControl>

