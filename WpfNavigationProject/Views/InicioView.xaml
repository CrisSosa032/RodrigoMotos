<UserControl x:Class="WpfNavigationProject.Views.Inicio"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
             mc:Ignorable="d"
             d:DesignHeight="700"
             d:DesignWidth="1100">

    <Grid Background="#F5F6FA">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>


        <!-- ===================================================== -->
        <!-- HEADER -->
        <!-- ===================================================== -->

        <Border Grid.Row="0"
                Background="White"
                Padding="30,24"
                BorderBrush="#E5E7EB"
                BorderThickness="0,0,0,1">

            <Grid>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>


                <Grid Grid.Row="0">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- SALUDO -->

                    <StackPanel Grid.Column="0"
                VerticalAlignment="Center">

                        <TextBlock x:Name="TxtSaludo"
                   Text="¡Hola! 👋"
                   FontSize="27"
                   FontWeight="SemiBold"
                   Foreground="#1F2937"/>

                        <TextBlock Text="Panel de control del taller"
                   Margin="0,5,0,0"
                   FontSize="14"
                   Foreground="#6B7280"/>

                    </StackPanel>


                    <!-- ACCIONES RÁPIDAS -->

                    <StackPanel Grid.Column="1"
                Orientation="Horizontal"
                VerticalAlignment="Center"
                Margin="20,0,0,0">

                        <!-- Nuevo cliente -->

                        <Button Width="145"
                Height="38"
                Margin="0,0,8,0"
                Background="#F8FAFC"
                BorderBrush="#D1D5DB"
                BorderThickness="1"
                Cursor="Hand"
                ToolTip="Registrar un nuevo cliente"
                Click="NuevoCliente_Click">

                            <StackPanel Orientation="Horizontal">

                                <TextBlock Text="👤"
                           FontSize="14"
                           VerticalAlignment="Center"/>

                                <TextBlock Text="Nuevo cliente"
                           Margin="7,0,0,0"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Foreground="#374151"
                           VerticalAlignment="Center"/>

                            </StackPanel>

                        </Button>


                        <!-- Nueva moto -->

                        <Button Width="135"
                Height="38"
                Margin="0,0,8,0"
                Background="#F8FAFC"
                BorderBrush="#D1D5DB"
                BorderThickness="1"
                Cursor="Hand"
                ToolTip="Registrar una nueva moto"
                Click="NuevaMoto_Click">

                            <StackPanel Orientation="Horizontal">

                                <TextBlock Text="🏍️"
                           FontSize="14"
                           VerticalAlignment="Center"/>

                                <TextBlock Text="Nueva moto"
                           Margin="7,0,0,0"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Foreground="#374151"
                           VerticalAlignment="Center"/>

                            </StackPanel>

                        </Button>


                        <!-- Nuevo servicio -->

                        <Button Width="150"
                Height="38"
                Background="#2563EB"
                BorderBrush="#2563EB"
                BorderThickness="1"
                Cursor="Hand"
                ToolTip="Crear un nuevo servicio"
                Click="NuevoServicio_Click">

                            <StackPanel Orientation="Horizontal">

                                <TextBlock Text="🔧"
                           FontSize="14"
                           VerticalAlignment="Center"/>

                                <TextBlock Text="Nuevo servicio"
                           Margin="7,0,0,0"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Foreground="White"
                           VerticalAlignment="Center"/>

                            </StackPanel>

                        </Button>

                    </StackPanel>

                </Grid>


                <!-- ================================================= -->
                <!-- RESUMEN DE FACTURACIÓN -->
                <!-- ================================================= -->

                <Border Grid.Row="1"
                    Margin="0,22,0,0"
                    Background="White"
                    CornerRadius="12"
                    Padding="22"
                    BorderBrush="#E5E7EB"
                    BorderThickness="1">

                    <Grid>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>


                        <!-- ================================================= -->
                        <!-- FACTURACIÓN -->
                        <!-- ================================================= -->

                        <StackPanel Grid.Column="0"
                            VerticalAlignment="Center">

                            <StackPanel Orientation="Horizontal">

                                <Border Width="42"
                                Height="42"
                                Background="#EAF8EF"
                                CornerRadius="10">

                                    <TextBlock Text="💰"
                               FontSize="20"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>

                                </Border>

                                <StackPanel Margin="13,0,0,0">

                                    <TextBlock Text="Facturación del mes"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="#374151"/>

                                    <TextBlock x:Name="TxtPeriodoFacturacion"
                               Text="Septiembre 2026"
                               Margin="0,2,0,0"
                               FontSize="11"
                               Foreground="#9CA3AF"/>

                                </StackPanel>

                            </StackPanel>


                            <TextBlock x:Name="TxtFacturacionMes"
                                Text="$ 0,00"
                                Margin="0,13,0,0"
                                FontSize="27"
                                FontWeight="Bold"
                                Foreground="#1F2937"/>

                        </StackPanel>


                        <!-- ================================================= -->
                        <!-- SERVICIOS COBRADOS -->
                        <!-- ================================================= -->

                        <Border Grid.Column="1"
                            Margin="20,0,10,0"
                            Padding="20,0,0,0"
                            BorderBrush="#E5E7EB"
                            BorderThickness="1,0,0,0">

                            <StackPanel VerticalAlignment="Center">

                                <TextBlock Text="Servicios cobrados"
                           FontSize="12"
                           Foreground="#6B7280"/>

                                <TextBlock x:Name="TxtServiciosCobrados"
                           Text="0"
                           Margin="0,4,0,0"
                           FontSize="24"
                           FontWeight="Bold"
                           Foreground="#1F2937"/>

                                <TextBlock Text="Durante el mes"
                           Margin="0,2,0,0"
                           FontSize="11"
                           Foreground="#9CA3AF"/>

                            </StackPanel>

                        </Border>


                        <!-- ================================================= -->
                        <!-- TICKET PROMEDIO -->
                        <!-- ================================================= -->

                        <Border Grid.Column="2"
                            Margin="10,0,0,0"
                            Padding="20,0,0,0"
                            BorderBrush="#E5E7EB"
                            BorderThickness="1,0,0,0">

                            <StackPanel VerticalAlignment="Center">

                                <TextBlock Text="Ticket promedio"
                           FontSize="12"
                           Foreground="#6B7280"/>

                                <TextBlock x:Name="TxtTicketPromedio"
                           Text="$ 0,00"
                           Margin="0,4,0,0"
                           FontSize="24"
                           FontWeight="Bold"
                           Foreground="#1F2937"/>

                                <TextBlock Text="Por servicio cobrado"
                           Margin="0,2,0,0"
                           FontSize="11"
                           Foreground="#9CA3AF"/>

                            </StackPanel>

                        </Border>

                    </Grid>

                </Border>

            </Grid>

        </Border>


        <!-- ===================================================== -->
        <!-- CONTENIDO PRINCIPAL -->
        <!-- ===================================================== -->

        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled" Cursor="">

            <StackPanel Margin="30,22,30,25">


                <!-- ================================================= -->
                <!-- GRÁFICO + RESUMEN -->
                <!-- ================================================= -->

                <Grid>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.25*"/>
                        <ColumnDefinition Width="0.75*"/>
                    </Grid.ColumnDefinitions>


                    <!-- ================================================= -->
                    <!-- GRÁFICO -->
                    <!-- ================================================= -->

                    <Border Grid.Column="0"
                            Margin="0,0,8,0"
                            Background="White"
                            CornerRadius="12"
                            Padding="22"
                            BorderBrush="#E5E7EB"
                            BorderThickness="1">

                        <Grid>

                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>


                            <!-- Título -->

                            <StackPanel Grid.Row="0">

                                <TextBlock Text="Actividad del mes"
                                           FontSize="18"
                                           FontWeight="SemiBold"
                                           Foreground="#1F2937"/>

                                <TextBlock x:Name="TxtPeriodoGrafico"
                                           Text="Servicios ingresados durante el mes actual"
                                           Margin="0,4,0,0"
                                           FontSize="12"
                                           Foreground="#6B7280"/>

                            </StackPanel>


                            <!-- Gráfico -->

                            <Grid Grid.Row="1"
                                  Margin="0,12,0,0">

                                <lvc:PieChart x:Name="ChartEstados"
                                              Height="245"
                                              LegendPosition="Bottom"
                                              HorizontalAlignment="Stretch"
                                              VerticalAlignment="Center"/>

                                <!-- Texto central -->
                                <StackPanel HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Margin="0,0,0,28">

                                    <TextBlock x:Name="TxtTotalServiciosMes"
                                               Text="0"
                                               FontSize="25"
                                               FontWeight="Bold"
                                               Foreground="#1F2937"
                                               HorizontalAlignment="Center"/>

                                    <TextBlock Text="servicios"
                                               FontSize="11"
                                               Foreground="#6B7280"
                                               HorizontalAlignment="Center"/>

                                </StackPanel>

                            </Grid>

                        </Grid>

                    </Border>


                    <!-- ================================================= -->
                    <!-- RESUMEN DEL TALLER -->
                    <!-- ================================================= -->

                    <Border Grid.Column="1"
                            Margin="8,0,0,0"
                            Background="White"
                            CornerRadius="12"
                            Padding="22"
                            BorderBrush="#E5E7EB"
                            BorderThickness="1">

                        <Grid>

                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>


                            <!-- Título -->

                            <StackPanel Grid.Row="0">

                                <TextBlock Text="Resumen del taller"
                                           FontSize="18"
                                           FontWeight="SemiBold"
                                           Foreground="#1F2937"/>

                                <TextBlock Text="Situación actual"
                                           Margin="0,4,0,0"
                                           FontSize="12"
                                           Foreground="#6B7280"/>

                            </StackPanel>


                            <!-- Indicadores -->

                            <StackPanel Grid.Row="1"
                                        Margin="0,18,0,0">


                                <!-- INGRESADAS -->

                                <Border Background="#FFFAF0"
                                        CornerRadius="9"
                                        Padding="13"
                                        Margin="0,0,0,9"
                                        Cursor="Hand"
                                        ToolTip="Ver servicios ingresados"
                                        MouseLeftButtonUp="ServiciosIngresados_Click">

                                    <Grid>

                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Text="📥"
                                                   FontSize="17"
                                                   VerticalAlignment="Center"/>

                                        <StackPanel Grid.Column="1"
                                                    Margin="10,0,0,0">

                                            <TextBlock Text="Ingresadas"
                                                       FontSize="13"
                                                       FontWeight="SemiBold"
                                                       Foreground="#374151"/>

                                            <TextBlock Text="Esperando comenzar"
                                                       FontSize="11"
                                                       Foreground="#9CA3AF"/>

                                        </StackPanel>

                                        <TextBlock x:Name="TxtResumenIngresadas"
                                                   Grid.Column="2"
                                                   Text="0"
                                                   FontSize="18"
                                                   FontWeight="Bold"
                                                   Foreground="#374151"
                                                   VerticalAlignment="Center"/>

                                    </Grid>

                                </Border>


                                <!-- EN PROCESO -->

                                <Border Background="#F3F7FF"
                                        CornerRadius="9"
                                        Padding="13"
                                        Margin="0,0,0,9"
                                        Cursor="Hand"
                                        ToolTip="Ver servicios en proceso"
                                        MouseLeftButtonUp="ServiciosEnProceso_Click">

                                    <Grid>

                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Text="🔧"
                                                   FontSize="17"
                                                   VerticalAlignment="Center"/>

                                        <StackPanel Grid.Column="1"
                                                    Margin="10,0,0,0">

                                            <TextBlock Text="En proceso"
                                                       FontSize="13"
                                                       FontWeight="SemiBold"
                                                       Foreground="#374151"/>

                                            <TextBlock Text="Trabajándose actualmente"
                                                       FontSize="11"
                                                       Foreground="#9CA3AF"/>

                                        </StackPanel>

                                        <TextBlock x:Name="TxtResumenEnProceso"
                                                   Grid.Column="2"
                                                   Text="0"
                                                   FontSize="18"
                                                   FontWeight="Bold"
                                                   Foreground="#374151"
                                                   VerticalAlignment="Center"/>

                                    </Grid>

                                </Border>


                                <!-- TERMINADAS -->

                                <Border Background="#F1FAF4"
                                        CornerRadius="9"
                                        Padding="13"
                                        Margin="0,0,0,9"
                                        Cursor="Hand"
                                        ToolTip="Ver servicios listos para entregar"
                                        MouseLeftButtonUp="ServiciosTerminados_Click">

                                    <Grid>

                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Text="🏁"
                                                   FontSize="17"
                                                   VerticalAlignment="Center"/>

                                        <StackPanel Grid.Column="1"
                                                    Margin="10,0,0,0">

                                            <TextBlock Text="Listas para entregar"
                                                       FontSize="13"
                                                       FontWeight="SemiBold"
                                                       Foreground="#374151"/>

                                            <TextBlock Text="Pendientes de entrega"
                                                       FontSize="11"
                                                       Foreground="#9CA3AF"/>

                                        </StackPanel>

                                        <TextBlock x:Name="TxtResumenTerminadas"
                                                   Grid.Column="2"
                                                   Text="0"
                                                   FontSize="18"
                                                   FontWeight="Bold"
                                                   Foreground="#374151"
                                                   VerticalAlignment="Center"/>

                                    </Grid>

                                </Border>


                                <!-- SEPARADOR -->

                                <Border Height="1"
                                        Background="#E5E7EB"
                                        Margin="0,7,0,15"/>


                                <!-- TOTAL DEL MES -->

                                <Grid>

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel>

                                        <TextBlock Text="Servicios del mes"
                                                   FontSize="12"
                                                   Foreground="#6B7280"/>

                                        <TextBlock Text="Total ingresado"
                                                   Margin="0,2,0,0"
                                                   FontSize="13"
                                                   FontWeight="SemiBold"
                                                   Foreground="#374151"/>

                                    </StackPanel>

                                    <TextBlock x:Name="TxtResumenTotalMes"
                                               Grid.Column="1"
                                               Text="0"
                                               FontSize="23"
                                               FontWeight="Bold"
                                               Foreground="#1F2937"
                                               VerticalAlignment="Center"/>

                                </Grid>

                            </StackPanel>

                        </Grid>

                    </Border>

                </Grid>


                <!-- ================================================= -->
                <!-- TRABAJOS EN CURSO -->
                <!-- ================================================= -->

                <Grid Margin="0,22,0,0">

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>


                    <!-- Título -->

                    <Grid Grid.Row="0">

                        <StackPanel>

                            <TextBlock Text="Trabajos en curso"
                                       FontSize="19"
                                       FontWeight="SemiBold"
                                       Foreground="#1F2937"/>

                            <TextBlock Text="Servicios actualmente en el taller"
                                       Margin="0,4,0,0"
                                       FontSize="12"
                                       Foreground="#6B7280"/>

                        </StackPanel>

                    </Grid>


                    <!-- Línea -->

                    <Border Grid.Row="1"
                            Height="1"
                            Background="#E5E7EB"
                            Margin="0,13,0,13"/>


                    <!-- Lista -->

                    <Border Grid.Row="2"
                            Background="Transparent">

                        <StackPanel>

                            <StackPanel x:Name="PanelTrabajos"/>


                            <!-- PAGINADO -->

                            <StackPanel Orientation="Horizontal"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Margin="0,10,0,0">

                                <Button x:Name="BtnPaginaTrabajosAnterior"
                                        Content="◀ Anterior"
                                        Width="100"
                                        Height="32"
                                        Margin="0,0,10,0"
                                        Click="BtnPaginaTrabajosAnterior_Click"
                                        Style="{StaticResource AccionButtonStyle}"/>

                                <TextBlock x:Name="TxtPaginaTrabajos"
                                           Text="Página 1 de 1"
                                           VerticalAlignment="Center"
                                           FontWeight="SemiBold"
                                           Foreground="#444444"
                                           Margin="5,0"/>

                                <Button x:Name="BtnPaginaTrabajosSiguiente"
                                        Content="Siguiente ▶"
                                        Width="100"
                                        Height="32"
                                        Margin="10,0,0,0"
                                        Click="BtnPaginaTrabajosSiguiente_Click"
                                        Style="{StaticResource AccionButtonStyle}"/>

                            </StackPanel>

                        </StackPanel>

                    </Border>

                </Grid>


            </StackPanel>

        </ScrollViewer>


        

    </Grid>

</UserControl>