<UserControl x:Class="WpfNavigationProject.Views.Inicio"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="700"
             d:DesignWidth="1100">

    <Grid Background="#F5F6FA">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>


        <!-- ===================================================== -->
        <!-- HEADER -->
        <!-- ===================================================== -->

        <Border Grid.Row="0"
                Background="White"
                Padding="30,25"
                BorderBrush="#E5E7EB"
                BorderThickness="0,0,0,1">

            <Grid>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>


                <!-- Saludo -->

                <StackPanel Grid.Row="0">
                    <TextBlock x:Name="TxtSaludo"
                               Text="¡Hola! 👋"
                               FontSize="27"
                               FontWeight="SemiBold"
                               Foreground="#1F2937"/>

                    <TextBlock Text="Resumen del taller"
                               Margin="0,5,0,0"
                               FontSize="14"
                               Foreground="#6B7280"/>

                </StackPanel>


                <!-- Estadísticas -->

                <Grid Grid.Row="1"
                      Margin="0,25,0,0">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>


                    <!-- Motos -->

                    <Border Grid.Column="0"
                            Margin="0,0,10,0"
                            Background="#F8FAFC"
                            CornerRadius="10"
                            Padding="18">

                        <Grid>

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Width="45"
                                    Height="45"
                                    Background="#E8F1FF"
                                    CornerRadius="10">

                                <TextBlock Text="🏍️"
                                           FontSize="22"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>

                            </Border>

                            <StackPanel Grid.Column="1"
                                        Margin="15,0,0,0"
                                        VerticalAlignment="Center">

                                <TextBlock x:Name="TxtCantidadMotos"
                                                    Text="0"
                                                    FontSize="23"
                                                    FontWeight="Bold"
                                                    Foreground="#1F2937"/>   
                                <TextBlock Text="Motos registradas"
                                           FontSize="13"
                                           Foreground="#6B7280"/>

                            </StackPanel>

                        </Grid>

                    </Border>


                    <!-- Clientes -->

                    <Border Grid.Column="1"
                            Margin="5,0"
                            Background="#F8FAFC"
                            CornerRadius="10"
                            Padding="18">

                        <Grid>

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Width="45"
                                    Height="45"
                                    Background="#EAF8EF"
                                    CornerRadius="10">

                                <TextBlock Text="👥"
                                           FontSize="22"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>

                            </Border>

                            <StackPanel Grid.Column="1"
                                        Margin="15,0,0,0"
                                        VerticalAlignment="Center">

                                <TextBlock x:Name="TxtCantidadClientes"
                                                    Text="0"
                                                    FontSize="23"
                                                    FontWeight="Bold"
                                                    Foreground="#1F2937"/>

                                <TextBlock Text="Clientes registrados"
                                           FontSize="13"
                                           Foreground="#6B7280"/>

                            </StackPanel>

                        </Grid>

                    </Border>


                    <!-- Trabajos -->

                    <Border Grid.Column="2"
                            Margin="10,0,0,0"
                            Background="#F8FAFC"
                            CornerRadius="10"
                            Padding="18">

                        <Grid>

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Width="45"
                                    Height="45"
                                    Background="#FFF5E6"
                                    CornerRadius="10">

                                <TextBlock Text="🔧"
                                           FontSize="22"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>

                            </Border>

                            <StackPanel Grid.Column="1"
                                        Margin="15,0,0,0"
                                        VerticalAlignment="Center">

                                <TextBlock x:Name="TxtCantidadTrabajos"
                                                    Text="0"
                                                    FontSize="23"
                                                    FontWeight="Bold"
                                                    Foreground="#1F2937"/>

                                <TextBlock Text="Trabajos en curso"
                                           FontSize="13"
                                           Foreground="#6B7280"/>

                            </StackPanel>

                        </Grid>

                    </Border>

                </Grid>

            </Grid>

        </Border>


        <!-- ===================================================== -->
        <!-- CENTRO - TRABAJOS EN CURSO -->
        <!-- ===================================================== -->

        <Grid Grid.Row="1"
              Margin="30,25,30,25">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>


            <!-- Título -->

            <Grid Grid.Row="0"
                  Margin="0,0,0,15">

                <TextBlock Text="Trabajos en curso"
                           FontSize="20"
                           FontWeight="SemiBold"
                           Foreground="#1F2937"/>

                <TextBlock Text="Servicios actualmente en el taller"
                           Margin="0,30,0,0"
                           FontSize="13"
                           Foreground="#6B7280"/>

            </Grid>


            <!-- Lista -->

            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Auto">

                <StackPanel x:Name="PanelTrabajos">


                    

                </StackPanel>

            </ScrollViewer>

        </Grid>


        <!-- ===================================================== -->
        <!-- FOOTER - ACCIONES RÁPIDAS -->
        <!-- ===================================================== -->

        <Border Grid.Row="2"
                Background="White"
                Padding="30,15"
                BorderBrush="#E5E7EB"
                BorderThickness="0,1,0,0">

            <Grid>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>


                <!-- Título -->

                <StackPanel Grid.Column="0"
                            VerticalAlignment="Center">

                    <TextBlock Text="⚡ Acciones rápidas"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="#374151"/>

                </StackPanel>


                <!-- Botones -->

                <StackPanel Grid.Column="2"
                            Orientation="Horizontal">


                    <!-- Nuevo cliente -->

                    <Button Width="155"
                            Height="42"
                            Margin="8,0,0,0"
                            Background="#F8FAFC"
                            BorderBrush="#D1D5DB"
                            BorderThickness="1"
                            Cursor="Hand"
                            ToolTip="Registrar un nuevo cliente" Click="NuevoCliente_Click">

                        <StackPanel Orientation="Horizontal">

                            <TextBlock Text="👤"
                                       FontSize="16"
                                       VerticalAlignment="Center"/>

                            <TextBlock Text="Nuevo cliente"
                                       Margin="8,0,0,0"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Foreground="#374151"
                                       VerticalAlignment="Center"/>

                        </StackPanel>

                    </Button>


                    <!-- Nueva moto -->

                    <Button Width="145"
                            Height="42"
                            Margin="8,0,0,0"
                            Background="#F8FAFC"
                            BorderBrush="#D1D5DB"
                            BorderThickness="1"
                            Cursor="Hand"
                            ToolTip="Registrar una nueva moto"
                            Click="NuevaMoto_Click">

                        <StackPanel Orientation="Horizontal">

                            <TextBlock Text="🏍️"
                                       FontSize="16"
                                       VerticalAlignment="Center"/>

                            <TextBlock Text="Nueva moto"
                                       Margin="8,0,0,0"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Foreground="#374151"
                                       VerticalAlignment="Center"/>

                        </StackPanel>

                    </Button>


                    <!-- Nuevo servicio -->

                    <Button Width="165"
                            Height="42"
                            Margin="8,0,0,0"
                            Background="#2563EB"
                            BorderBrush="#2563EB"
                            BorderThickness="1"
                            Cursor="Hand"
                            ToolTip="Crear un nuevo servicio"
                            Click="NuevoServicio_Click">

                        <StackPanel Orientation="Horizontal">

                            <TextBlock Text="🔧"
                                       FontSize="16"
                                       VerticalAlignment="Center"/>

                            <TextBlock Text="Nuevo servicio"
                                       Margin="8,0,0,0"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Foreground="White"
                                       VerticalAlignment="Center"/>

                        </StackPanel>

                    </Button>

                </StackPanel>

            </Grid>

        </Border>

    </Grid>

</UserControl>