<UserControl x:Class="WpfNavigationProject.Views.ServicioFormView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="650"
             d:DesignWidth="1000">

    <Grid Margin="20">

        <Border Background="White"
                CornerRadius="15"
                Padding="25">

            <Border.Effect>
                <DropShadowEffect
                    BlurRadius="18"
                    ShadowDepth="3"
                    Opacity="0.18"/>
            </Border.Effect>

            <Grid>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="20"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="20"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- ================================================= -->
                <!-- TITULO -->
                <!-- ================================================= -->

                <TextBlock x:Name="TxtTitulo"
                           Grid.Row="0"
                           Text="Nuevo servicio"
                           FontSize="32"
                           FontWeight="Bold"
                           Foreground="#222222"
                           HorizontalAlignment="Center"/>

                <!-- ================================================= -->
                <!-- CONTENIDO -->
                <!-- ================================================= -->

                <Grid Grid.Row="2">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="0.95*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="1.6*"/>
                    </Grid.ColumnDefinitions>

                    <!-- ================================================= -->
                    <!-- PANEL IZQUIERDO -->
                    <!-- ================================================= -->

                    <Border Grid.Column="0"
                            Background="#F5F7FA"
                            CornerRadius="10"
                            Padding="17">

                        <StackPanel>

                            <TextBlock Text="Cliente"
                                       FontSize="20"
                                       FontWeight="Bold"
                                       Foreground="#333333"
                                       Margin="0,0,0,10"/>

                            <!-- BUSCADOR CLIENTE -->

                            <Grid>

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBox x:Name="TxtBuscarCliente"
                                         Grid.Column="0"
                                         Height="36"
                                         Padding="10,0"
                                         VerticalContentAlignment="Center"
                                         FontSize="14"
                                         TextChanged="TxtBuscarCliente_TextChanged"/>

                                <Button Grid.Column="2"
                                        Content="Limpiar"
                                        Height="36"
                                        Padding="15,0"
                                        Background="#E9ECEF"
                                        Foreground="#333333"
                                        BorderThickness="0"
                                        Cursor="Hand"
                                        Click="BtnLimpiarCliente_Click"/>

                            </Grid>

                            <!-- RESULTADOS DE CLIENTES -->

                            <ListBox x:Name="LstClientes"
                                     Margin="0,8,0,15"
                                     MaxHeight="125"
                                     DisplayMemberPath="Nombre"
                                     SelectionChanged="LstClientes_SelectionChanged"/>

                            <!-- TITULO MOTOS -->

                            <TextBlock x:Name="TxtTituloMotos"
                                       Text="Motos del cliente"
                                       FontSize="18"
                                       FontWeight="Bold"
                                       Foreground="#333333"
                                       Margin="0,0,0,8"
                                       Visibility="Collapsed"/>

                            <!-- MOTOS -->

                            <ScrollViewer MaxHeight="190"
                                          VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled">

                                <ListBox x:Name="LstMotos"
                                         SelectionChanged="LstMotos_SelectionChanged"
                                         Visibility="Collapsed">

                                    <ListBox.ItemTemplate>
                                        <DataTemplate>

                                            <Border Background="White"
                                                    BorderBrush="#E0E0E0"
                                                    BorderThickness="1"
                                                    CornerRadius="6"
                                                    Margin="0,0,0,6"
                                                    Padding="10">

                                                <StackPanel>

                                                    <TextBlock FontSize="15"
                                                               FontWeight="Bold"
                                                               Foreground="#222222">

                                                        <Run Text="{Binding Marca}"/>
                                                        <Run Text=" "/>
                                                        <Run Text="{Binding Modelo}"/>

                                                    </TextBlock>

                                                    <TextBlock Text="{Binding Patente}"
                                                               FontSize="13"
                                                               Foreground="#666666"
                                                               Margin="0,3,0,0"/>

                                                </StackPanel>

                                            </Border>

                                        </DataTemplate>
                                    </ListBox.ItemTemplate>

                                </ListBox>

                            </ScrollViewer>

                            <!-- MOTO SELECCIONADA -->

                            <TextBlock Text="Moto seleccionada"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       Foreground="#555555"
                                       Margin="0,15,0,5"/>

                            <Border Background="White"
                                    BorderBrush="#D9DDE3"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="10">

                                <TextBlock x:Name="TxtMotoSeleccionada"
                                           Text="Seleccioná una moto"
                                           FontSize="14"
                                           Foreground="#555555"/>

                            </Border>

                        </StackPanel>

                    </Border>

                    <!-- ================================================= -->
                    <!-- PANEL DERECHO -->
                    <!-- ================================================= -->

                    <Border Grid.Column="2"
                            Background="#F5F7FA"
                            CornerRadius="10"
                            Padding="20">

                        <StackPanel>

                            <!-- ESTADO -->

                            <TextBlock Text="Estado"
                                       FontSize="15"
                                       FontWeight="SemiBold"
                                       Foreground="#333333"
                                       Margin="0,0,0,5"/>

                            <ComboBox x:Name="CmbEstado"
                                      Height="36"
                                      FontSize="14"
                                      Margin="0,0,0,15"/>

                            <!-- DETALLE -->

                            <TextBlock Text="Detalle del servicio"
                                       FontSize="15"
                                       FontWeight="SemiBold"
                                       Foreground="#333333"
                                       Margin="0,0,0,5"/>

                            <TextBox x:Name="TxtDetalle"
                                     Height="95"
                                     FontSize="12"
                                     Padding="10"
                                     TextWrapping="Wrap"
                                     AcceptsReturn="True"
                                     VerticalScrollBarVisibility="Auto"
                                     Margin="0,0,0,15"/>

                            <!-- COSTO -->

                            <TextBlock Text="Costo estimado"
                                       FontSize="15"
                                       FontWeight="SemiBold"
                                       Foreground="#333333"
                                       Margin="0,0,0,5"/>

                            <TextBox x:Name="TxtCosto"
                                     Height="36"
                                     FontSize="12"
                                     Padding="10"
                                     VerticalContentAlignment="Center"/>

                        </StackPanel>

                    </Border>

                </Grid>

                <!-- ================================================= -->
                <!-- BOTON GUARDAR -->
                <!-- ================================================= -->

                <Button x:Name="BtnCargarServicio"
                        Grid.Row="4"
                        Content="Registrar servicio"
                        Width="210"
                        Height="42"
                        HorizontalAlignment="Center"
                        Background="#007ACC"
                        Foreground="White"
                        BorderThickness="0"
                        FontSize="15"
                        FontWeight="SemiBold"
                        Cursor="Hand"
                        Click="BtnCargarServicio_Click"/>

            </Grid>

        </Border>

    </Grid>

</UserControl>