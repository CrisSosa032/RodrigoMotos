<UserControl x:Class="WpfNavigationProject.Views.ServicioFormView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="800">

    <Grid Margin="20">
        <Border Background="#F9F9F9" 
                CornerRadius="10" 
                Padding="30" 
                BorderBrush="#DDD" 
                BorderThickness="1"
                HorizontalAlignment="Center" 
                VerticalAlignment="Center">

            <Grid Width="600" VerticalAlignment="Top">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="0.5*"/>
                </Grid.ColumnDefinitions>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <!-- Título -->
                    <RowDefinition Height="25"/>
                    <RowDefinition Height="Auto"/>
                    <!-- ID Moto -->
                    <RowDefinition Height="15"/>
                    <RowDefinition Height="Auto"/>
                    <!-- ID Estado -->
                    <RowDefinition Height="15"/>
                    <RowDefinition Height="Auto"/>
                    <!-- Fecha Entrada -->
                    <RowDefinition Height="15"/>
                    <RowDefinition Height="Auto"/>
                    <!-- Costo Estimado -->
                    <RowDefinition Height="15"/>
                    <RowDefinition Height="Auto"/>
                    <!-- Detalle -->
                    <RowDefinition Height="30"/>
                    <RowDefinition Height="Auto"/>
                    <!-- Botón -->
                </Grid.RowDefinitions>

                <Label Content="Registro de Servicio" 
                       Grid.Column="0" 
                       Grid.ColumnSpan="3" 
                       FontSize="24" 
                       FontWeight="Bold" 
                       Foreground="#007ACC" 
                       Margin="0,0,0,20"/>

                <Label Grid.Row="2"
                       Grid.Column="0"
                       Content="ID de la Moto:"
                       VerticalAlignment="Center"
                       FontWeight="SemiBold"/>

                <TextBox Grid.Row="2"
                         Grid.Column="1"
                         Name="TxtIdMoto"
                         Padding="5"
                         VerticalContentAlignment="Center"
                         Height="35"/>

                <Label Grid.Row="4"
                       Grid.Column="0"
                       Content="ID del Estado:"
                       VerticalAlignment="Center"
                       FontWeight="SemiBold"/>

                <TextBox Grid.Row="4"
                         Grid.Column="1"
                         Name="TxtIdEstado"
                         Padding="5"
                         VerticalContentAlignment="Center"
                         Height="35"/>

                <Label Grid.Row="6"
                       Grid.Column="0"
                       Content="Fecha de Entrada:"
                       VerticalAlignment="Center"
                       FontWeight="SemiBold"/>

                <!--
                    La fecha es generada automáticamente por SQL Server.
                    El usuario puede verla, pero no modificarla.
                -->
                <DatePicker Grid.Row="6"
                            Grid.Column="1"
                            Name="DpFechaEntrada"
                            Padding="5"
                            VerticalContentAlignment="Center"
                            Height="35"
                            IsEnabled="False"/>

                <Label Grid.Row="8"
                       Grid.Column="0"
                       Content="Costo Estimado ($):"
                       VerticalAlignment="Center"
                       FontWeight="SemiBold"/>

                <TextBox Grid.Row="8"
                         Grid.Column="1"
                         Name="TxtCostoEstimado"
                         Padding="5"
                         VerticalContentAlignment="Center"
                         Height="35"/>

                <Label Grid.Row="10"
                       Grid.Column="0"
                       Content="Detalle del Trabajo:"
                       VerticalAlignment="Top"
                       FontWeight="SemiBold"
                       Margin="0,5,0,0"/>

                <TextBox Grid.Row="10"
                         Grid.Column="1"
                         Name="TxtDetalle"
                         Padding="5"
                         Height="90"
                         TextWrapping="Wrap"
                         AcceptsReturn="True"
                         VerticalContentAlignment="Top"/>

                <Button Grid.Row="12"
                        Grid.Column="0"
                        Grid.ColumnSpan="2"
                        Name="BtnCargarServicio" 
                        Content="Guardar Servicio" 
                        HorizontalAlignment="Center"
                        Width="200"
                        Height="40" 
                        Click="BtnCargarServicio_Click"/>

            </Grid>
        </Border>
    </Grid>
</UserControl>