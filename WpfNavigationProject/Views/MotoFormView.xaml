<UserControl x:Class="WpfNavigationProject.Views.MotoFormView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="800">

    <Grid Margin="20">
        <Border Background="#F9F9F9" 
                CornerRadius="10" 
                Padding="30" 
                BorderBrush="#DDD" 
                BorderThickness="1"
                HorizontalAlignment="Center" 
                VerticalAlignment="Center">

            <Grid Width="600" VerticalAlignment="Top">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="0.5*"/>
                </Grid.ColumnDefinitions>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <!-- Título -->
                    <RowDefinition Height="25"/>
                    <RowDefinition Height="Auto"/>
                    <!-- ID Cliente -->
                    <RowDefinition Height="15"/>
                    <RowDefinition Height="Auto"/>
                    <!-- Marca -->
                    <RowDefinition Height="15"/>
                    <RowDefinition Height="Auto"/>
                    <!-- Modelo -->
                    <RowDefinition Height="15"/>
                    <RowDefinition Height="Auto"/>
                    <!-- Año -->
                    <RowDefinition Height="15"/>
                    <RowDefinition Height="Auto"/>
                    <!-- Patente -->
                    <RowDefinition Height="15"/>
                    <RowDefinition Height="Auto"/>
                    <!-- Motor -->
                    <RowDefinition Height="15"/>
                    <RowDefinition Height="Auto"/>
                    <!-- Chasis -->
                    <RowDefinition Height="15"/>
                    <RowDefinition Height="Auto"/>
                    <!-- Observaciones -->
                    <RowDefinition Height="30"/>
                    <RowDefinition Height="Auto"/>
                    <!-- Botón -->
                </Grid.RowDefinitions>

                <Label Content="Registro de Motos" 
                       Grid.Column="0" 
                       Grid.ColumnSpan="3" 
                       FontSize="24" 
                       FontWeight="Bold" 
                       Foreground="#007ACC" 
                       Margin="0,0,0,20"/>

                <Label Grid.Row="2" Grid.Column="0" Content="ID del Dueño (Cliente):" VerticalAlignment="Center" FontWeight="SemiBold"/>
                <TextBox Grid.Row="2" Grid.Column="1" Name="TxtIdCliente" Padding="5" VerticalContentAlignment="Center" Height="35"/>

                <Label Grid.Row="4" Grid.Column="0" Content="Marca:" VerticalAlignment="Center" FontWeight="SemiBold"/>
                <TextBox Grid.Row="4" Grid.Column="1" Name="TxtMarca" Padding="5" VerticalContentAlignment="Center" Height="35"/>

                <Label Grid.Row="6" Grid.Column="0" Content="Modelo:" VerticalAlignment="Center" FontWeight="SemiBold"/>
                <TextBox Grid.Row="6" Grid.Column="1" Name="TxtModelo" Padding="5" VerticalContentAlignment="Center" Height="35"/>

                <Label Grid.Row="8" Grid.Column="0" Content="Año:" VerticalAlignment="Center" FontWeight="SemiBold"/>
                <TextBox Grid.Row="8" Grid.Column="1" Name="TxtAnio" Padding="5" VerticalContentAlignment="Center" Height="35"/>

                <Label Grid.Row="10" Grid.Column="0" Content="Patente:" VerticalAlignment="Center" FontWeight="SemiBold"/>
                <TextBox Grid.Row="10" Grid.Column="1" Name="TxtPatente" Padding="5" VerticalContentAlignment="Center" Height="35"/>

                <Label Grid.Row="12" Grid.Column="0" Content="Nro. de Motor:" VerticalAlignment="Center" FontWeight="SemiBold"/>
                <TextBox Grid.Row="12" Grid.Column="1" Name="TxtMotor" Padding="5" VerticalContentAlignment="Center" Height="35"/>

                <Label Grid.Row="14" Grid.Column="0" Content="Nro. de Chasis:" VerticalAlignment="Center" FontWeight="SemiBold"/>
                <TextBox Grid.Row="14" Grid.Column="1" Name="TxtChasis" Padding="5" VerticalContentAlignment="Center" Height="35"/>

                <!-- Observaciones (Más alto para permitir varias líneas) -->
                <Label Grid.Row="16" Grid.Column="0" Content="Observaciones:" VerticalAlignment="Top" FontWeight="SemiBold" Margin="0,5,0,0"/>
                <TextBox Grid.Row="16" Grid.Column="1" Name="TxtObservaciones" Padding="5" Height="70" TextWrapping="Wrap" AcceptsReturn="True" VerticalContentAlignment="Top"/>

                <Button Grid.Row="18" Grid.Column="0" Grid.ColumnSpan="2"
                        Name="BtnCargarMoto" 
                        Content="Guardar Moto" 
                        HorizontalAlignment="Center"
                        Width="200"
                        Height="40" 
                        Click="BtnCargarMoto_Click"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>