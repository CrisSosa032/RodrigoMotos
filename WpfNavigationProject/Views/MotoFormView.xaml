 <UserControl x:Class="WpfNavigationProject.Views.MotoFormView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="650"
             d:DesignWidth="1000"
             Background="Transparent">

    <UserControl.Resources>

        <!-- Sombra estándar -->
        <DropShadowEffect x:Key="ShadowDepth3"
                          Color="Black"
                          Direction="270"
                          ShadowDepth="3"
                          BlurRadius="5"
                          Opacity="0.1"/>

    </UserControl.Resources>


    <Grid Margin="20">

        <Border Background="White"
                CornerRadius="15"
                Padding="30"
                Effect="{StaticResource ShadowDepth3}">

            <Grid>

                <Grid.RowDefinitions>

                    <!-- Título -->
                    <RowDefinition Height="Auto"/>

                    <!-- Contenido -->
                    <RowDefinition Height="*"/>

                    <!-- Botón -->
                    <RowDefinition Height="Auto"/>

                </Grid.RowDefinitions>


                <!-- ===================================================== -->
                <!-- TÍTULO -->
                <!-- ===================================================== -->

                <StackPanel Grid.Row="0"
                            Margin="0,0,0,25">

                    <TextBlock x:Name="TxtTitulo"
                               Text="Registrar nueva moto"
                               FontSize="30"
                               FontWeight="Bold"
                               Foreground="#333333"
                               HorizontalAlignment="Center"/>

                    <TextBlock Text="Seleccioná el cliente y completá los datos de la moto"
                               FontSize="14"
                               Foreground="#666666"
                               HorizontalAlignment="Center"
                               Margin="0,5,0,0"/>

                </StackPanel>


                <!-- ===================================================== -->
                <!-- CONTENIDO EN DOS COLUMNAS -->
                <!-- ===================================================== -->

                <Grid Grid.Row="1">

                    <Grid.ColumnDefinitions>

                        <!-- Cliente -->
                        <ColumnDefinition Width="0.9*"/>

                        <!-- Separación -->
                        <ColumnDefinition Width="20"/>

                        <!-- Moto -->
                        <ColumnDefinition Width="1.6*"/>

                    </Grid.ColumnDefinitions>


                    <!-- ================================================= -->
                    <!-- COLUMNA IZQUIERDA - CLIENTE -->
                    <!-- ================================================= -->

                    <Border Grid.Column="0"
                            Background="#F5F7FA"
                            CornerRadius="10"
                            Padding="20">

                        <Grid>

                            <Grid.RowDefinitions>

                                <!-- Título -->
                                <RowDefinition Height="Auto"/>

                                <!-- Descripción -->
                                <RowDefinition Height="Auto"/>

                                <!-- Buscador -->
                                <RowDefinition Height="Auto"/>

                                <!-- Resultados -->
                                <RowDefinition Height="*"/>

                                <!-- Seleccionado -->
                                <RowDefinition Height="Auto"/>

                            </Grid.RowDefinitions>


                            <!-- ============================= -->
                            <!-- TÍTULO -->
                            <!-- ============================= -->

                            <TextBlock Grid.Row="0"
                                       Text="Cliente"
                                       FontSize="20"
                                       FontWeight="SemiBold"
                                       Foreground="#333333"/>


                            <TextBlock Grid.Row="1"
                                       Text="Buscá por nombre o DNI"
                                       FontSize="13"
                                       Foreground="#666666"
                                       Margin="0,3,0,12"/>


                            <!-- ============================= -->
                            <!-- BUSCADOR -->
                            <!-- ============================= -->

                            <TextBox x:Name="TxtBuscarCliente"
                                     Grid.Row="2"
                                     Height="36"
                                     Padding="10,5"
                                     FontSize="14"
                                     VerticalContentAlignment="Center"
                                     TextChanged="TxtBuscarCliente_TextChanged"
                                     ToolTip="Buscar cliente por nombre o DNI"/>


                            <!-- ============================= -->
                            <!-- RESULTADOS -->
                            <!-- ============================= -->

                            <Border Grid.Row="3"
                                    Margin="0,10,0,10"
                                    Background="White"
                                    BorderBrush="#D9DEE5"
                                    BorderThickness="1"
                                    CornerRadius="6">

                                <ListBox x:Name="LstClientes"
                                         BorderThickness="0"
                                         Background="White"
                                         SelectionChanged="LstClientes_SelectionChanged"
                                         ScrollViewer.VerticalScrollBarVisibility="Auto">

                                    <ListBox.ItemTemplate>

                                        <DataTemplate>

                                            <Border Padding="10"
                                                    BorderBrush="#EEEEEE"
                                                    BorderThickness="0,0,0,1">

                                                <Grid>

                                                    <Grid.ColumnDefinitions>

                                                        <ColumnDefinition Width="*"/>

                                                    </Grid.ColumnDefinitions>


                                                    <StackPanel>

                                                        <TextBlock Text="{Binding Nombre}"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="#333333"/>

                                                        <TextBlock Text="{Binding DNI, StringFormat=DNI: {0}}"
                                                                   FontSize="12"
                                                                   Foreground="#777777"
                                                                   Margin="0,3,0,0"/>

                                                    </StackPanel>

                                                </Grid>

                                            </Border>

                                        </DataTemplate>

                                    </ListBox.ItemTemplate>

                                </ListBox>

                            </Border>


                            <!-- ============================= -->
                            <!-- CLIENTE SELECCIONADO -->
                            <!-- ============================= -->

                            <Border x:Name="PanelClienteSeleccionado"
                                    Grid.Row="4"
                                    Background="#E8F5E9"
                                    BorderBrush="#81C784"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="12"
                                    Visibility="Collapsed">

                                <Grid>

                                    <Grid.ColumnDefinitions>

                                        <ColumnDefinition Width="*"/>

                                        <ColumnDefinition Width="Auto"/>

                                    </Grid.ColumnDefinitions>


                                    <StackPanel Grid.Column="0">

                                        <TextBlock Text="✓ Cliente seleccionado"
                                                   FontSize="12"
                                                   Foreground="#558B5A"/>

                                        <TextBlock x:Name="TxtClienteSeleccionado"
                                                   FontSize="15"
                                                   FontWeight="SemiBold"
                                                   Foreground="#2E7D32"
                                                   TextWrapping="Wrap"
                                                   Margin="0,3,0,0"/>

                                    </StackPanel>


                                    <Button Grid.Column="1"
                                            Content="Cambiar"
                                            Width="75"
                                            Height="28"
                                            Margin="10,0,0,0"
                                            Click="BtnCambiarCliente_Click"
                                            Style="{StaticResource AccionButtonStyle}"/>

                                </Grid>

                            </Border>

                        </Grid>

                    </Border>


                    <!-- ================================================= -->
                    <!-- COLUMNA DERECHA - DATOS DE LA MOTO -->
                    <!-- ================================================= -->

                    <Border Grid.Column="2"
                            Background="#F5F7FA"
                            CornerRadius="10"
                            Padding="20">

                        <Grid>

                            <Grid.RowDefinitions>

                                <!-- Título -->
                                <RowDefinition Height="Auto"/>

                                <!-- Marca / Modelo -->
                                <RowDefinition Height="Auto"/>

                                <!-- Año / Patente -->
                                <RowDefinition Height="Auto"/>

                                <!-- Motor / Chasis -->
                                <RowDefinition Height="Auto"/>

                                <!-- Observaciones -->
                                <RowDefinition Height="*"/>

                            </Grid.RowDefinitions>


                            <Grid.ColumnDefinitions>

                                <ColumnDefinition Width="*"/>

                                <ColumnDefinition Width="*"/>

                            </Grid.ColumnDefinitions>


                            <!-- ============================= -->
                            <!-- TÍTULO -->
                            <!-- ============================= -->

                            <TextBlock Grid.Row="0"
                                       Grid.ColumnSpan="2"
                                       Text="Datos de la moto"
                                       FontSize="20"
                                       FontWeight="SemiBold"
                                       Foreground="#333333"
                                       Margin="0,0,0,15"/>


                            <!-- ============================= -->
                            <!-- MARCA -->
                            <!-- ============================= -->

                            <StackPanel Grid.Row="1"
                                        Grid.Column="0"
                                        Margin="0,0,10,12">

                                <TextBlock Text="Marca"
                                           FontWeight="SemiBold"
                                           Foreground="#444444"
                                           Margin="0,0,0,5"/>

                                <TextBox x:Name="TxtMarca"
                                         Height="35"
                                         Padding="8,4"
                                         VerticalContentAlignment="Center"/>

                            </StackPanel>


                            <!-- ============================= -->
                            <!-- MODELO -->
                            <!-- ============================= -->

                            <StackPanel Grid.Row="1"
                                        Grid.Column="1"
                                        Margin="10,0,0,12">

                                <TextBlock Text="Modelo"
                                           FontWeight="SemiBold"
                                           Foreground="#444444"
                                           Margin="0,0,0,5"/>

                                <TextBox x:Name="TxtModelo"
                                         Height="35"
                                         Padding="8,4"
                                         VerticalContentAlignment="Center"/>

                            </StackPanel>


                            <!-- ============================= -->
                            <!-- AÑO -->
                            <!-- ============================= -->

                            <StackPanel Grid.Row="2"
                                        Grid.Column="0"
                                        Margin="0,0,10,12">

                                <TextBlock Text="Año"
                                           FontWeight="SemiBold"
                                           Foreground="#444444"
                                           Margin="0,0,0,5"/>

                                <TextBox x:Name="TxtAnio"
                                         Height="35"
                                         Padding="8,4"
                                         VerticalContentAlignment="Center"/>

                            </StackPanel>


                            <!-- ============================= -->
                            <!-- PATENTE -->
                            <!-- ============================= -->

                            <StackPanel Grid.Row="2"
                                        Grid.Column="1"
                                        Margin="10,0,0,12">

                                <TextBlock Text="Patente"
                                           FontWeight="SemiBold"
                                           Foreground="#444444"
                                           Margin="0,0,0,5"/>

                                <TextBox x:Name="TxtPatente"
                                         Height="35"
                                         Padding="8,4"
                                         VerticalContentAlignment="Center"/>

                            </StackPanel>


                            <!-- ============================= -->
                            <!-- MOTOR -->
                            <!-- ============================= -->

                            <StackPanel Grid.Row="3"
                                        Grid.Column="0"
                                        Margin="0,0,10,12">

                                <TextBlock Text="N.º de motor"
                                           FontWeight="SemiBold"
                                           Foreground="#444444"
                                           Margin="0,0,0,5"/>

                                <TextBox x:Name="TxtMotor"
                                         Height="35"
                                         Padding="8,4"
                                         VerticalContentAlignment="Center"/>

                            </StackPanel>


                            <!-- ============================= -->
                            <!-- CHASIS -->
                            <!-- ============================= -->

                            <StackPanel Grid.Row="3"
                                        Grid.Column="1"
                                        Margin="10,0,0,12">

                                <TextBlock Text="N.º de chasis"
                                           FontWeight="SemiBold"
                                           Foreground="#444444"
                                           Margin="0,0,0,5"/>

                                <TextBox x:Name="TxtChasis"
                                         Height="35"
                                         Padding="8,4"
                                         VerticalContentAlignment="Center"/>

                            </StackPanel>


                            <!-- ============================= -->
                            <!-- OBSERVACIONES -->
                            <!-- ============================= -->

                            <StackPanel Grid.Row="4"
                                        Grid.ColumnSpan="2"
                                        Margin="0,0,0,0">

                                <TextBlock Text="Observaciones"
                                           FontWeight="SemiBold"
                                           Foreground="#444444"
                                           Margin="0,0,0,5"/>

                                <TextBox x:Name="TxtObservaciones"
                                         MinHeight="90"
                                         Padding="8"
                                         TextWrapping="Wrap"
                                         AcceptsReturn="True"
                                         VerticalContentAlignment="Top"/>

                            </StackPanel>

                        </Grid>

                    </Border>

                </Grid>


                <!-- ===================================================== -->
                <!-- BOTÓN GUARDAR -->
                <!-- ===================================================== -->

                <Button Grid.Row="2"
                        x:Name="BtnCargarMoto"
                        Content="Guardar Moto"
                        Width="200"
                        Height="40"
                        HorizontalAlignment="Center"
                        Margin="0,20,0,0"
                        Click="BtnCargarMoto_Click"
                        Style="{StaticResource AccionButtonStyle}"/>

            </Grid>

        </Border>

    </Grid>

</UserControl>
