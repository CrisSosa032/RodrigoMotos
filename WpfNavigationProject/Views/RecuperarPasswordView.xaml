<Window x:Class="WPF_LoginForm.View.RecuperarPasswordView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Recuperar contraseña"
        Height="550"
        Width="800"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="Transparent"
        AllowsTransparency="True"
        MouseDown="Window_MouseDown">

    <Border CornerRadius="12">

        <Border.Background>
            <ImageBrush ImageSource="/Images/back-image.jpg"
                        Stretch="None"/>
        </Border.Background>

        <Border CornerRadius="10"
                BorderThickness="2"
                Opacity="0.95">

            <Border.BorderBrush>
                <LinearGradientBrush StartPoint="0,0"
                                     EndPoint="1,1">

                    <GradientStop Color="#462AD8"
                                  Offset="0"/>

                    <GradientStop Color="#DA34AE"
                                  Offset="0.75"/>

                    <GradientStop Color="#8A16C1"
                                  Offset="1"/>

                </LinearGradientBrush>
            </Border.BorderBrush>

            <Border.Background>
                <LinearGradientBrush StartPoint="0,1"
                                     EndPoint="1,0">

                    <GradientStop Color="#060531"
                                  Offset="0"/>

                    <GradientStop Color="#1B1448"
                                  Offset="1"/>

                </LinearGradientBrush>
            </Border.Background>


            <Grid>

                <Grid.RowDefinitions>
                    <RowDefinition Height="30"/>
                    <RowDefinition/>
                </Grid.RowDefinitions>


                <!-- BARRA SUPERIOR -->

                <Grid Grid.Row="0">

                    <Grid.ColumnDefinitions>

                        <ColumnDefinition/>

                        <ColumnDefinition Width="25"/>

                        <ColumnDefinition Width="25"/>

                        <ColumnDefinition Width="5"/>

                    </Grid.ColumnDefinitions>


                    <TextBlock Text="RECUPERAR CONTRASEÑA"
                               Foreground="DarkGray"
                               FontSize="10"
                               FontFamily="Montserrat"
                               Grid.Column="0"
                               VerticalAlignment="Center"
                               Margin="10,0,0,0"/>


                    <Button x:Name="btnClose"
                            BorderThickness="0"
                            Content="X"
                            Foreground="White"
                            FontSize="12"
                            FontFamily="Montserrat"
                            Cursor="Hand"
                            Grid.Column="2"
                            Click="btnClose_Click">

                        <Button.Style>

                            <Style TargetType="Button">

                                <Setter Property="Background"
                                        Value="#DA34AE"/>

                                <Style.Triggers>

                                    <Trigger Property="IsMouseOver"
                                             Value="True">

                                        <Setter Property="Background"
                                                Value="#C62DAE"/>

                                    </Trigger>

                                </Style.Triggers>

                            </Style>

                        </Button.Style>


                        <Button.Template>

                            <ControlTemplate TargetType="Button">

                                <Border Width="18"
                                        Height="18"
                                        CornerRadius="9"
                                        Background="{TemplateBinding Background}">

                                    <ContentPresenter
                                        VerticalAlignment="Center"
                                        HorizontalAlignment="Center"/>

                                </Border>

                            </ControlTemplate>

                        </Button.Template>

                    </Button>

                </Grid>


                <!-- CONTENIDO -->

                <Grid Grid.Row="1"
                      Width="300"
                      Margin="0,35,0,20">


                    <!-- ================================================= -->
                    <!-- PASO 1 -->
                    <!-- ================================================= -->

                    <StackPanel x:Name="panelUsuario"
                                Visibility="Visible">

                        <Image Source="/Images/Logo.png"
                               Width="150"
                               Height="150"
                               Margin="0,0,0,10"/>


                        <TextBlock Text="RECUPERAR CONTRASEÑA"
                                   Foreground="White"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   FontFamily="Montserrat"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,10"/>


                        <TextBlock Text="Ingresá tu usuario para comenzar"
                                   Foreground="DarkGray"
                                   FontSize="12"
                                   FontFamily="Montserrat"
                                   TextAlignment="Center"
                                   Margin="0,0,0,25"/>


                        <TextBlock Text="Usuario"
                                   Foreground="DarkGray"
                                   FontSize="12"
                                   FontWeight="Medium"
                                   FontFamily="Montserrat"/>


                        <TextBox x:Name="txtUsuario"
                                 FontSize="13"
                                 FontWeight="Medium"
                                 FontFamily="Montserrat"
                                 Foreground="Black"
                                 CaretBrush="LightGray"
                                 BorderBrush="DarkGray"
                                 BorderThickness="0,0,0,2"
                                 Height="28"
                                 VerticalContentAlignment="Center"
                                 Margin="0,5,0,0"
                                 Padding="5,0,0,0"/>


                        <Button x:Name="btnEnviarCodigo"
                                BorderThickness="0"
                                Content="CONTINUAR"
                                Foreground="White"
                                FontSize="12"
                                FontFamily="Montserrat"
                                Cursor="Hand"
                                Margin="0,40,0,0"
                                Click="btnEnviarCodigo_Click">

                            <Button.Style>

                                <Style TargetType="Button">

                                    <Setter Property="Background"
                                            Value="#462AD8"/>

                                    <Style.Triggers>

                                        <Trigger Property="IsMouseOver"
                                                 Value="True">

                                            <Setter Property="Background"
                                                    Value="#28AEED"/>

                                        </Trigger>

                                    </Style.Triggers>

                                </Style>

                            </Button.Style>


                            <Button.Template>

                                <ControlTemplate TargetType="Button">

                                    <Border Width="150"
                                            Height="40"
                                            CornerRadius="20"
                                            Background="{TemplateBinding Background}">

                                        <ContentPresenter
                                            VerticalAlignment="Center"
                                            HorizontalAlignment="Center"/>

                                    </Border>

                                </ControlTemplate>

                            </Button.Template>

                        </Button>

                    </StackPanel>


                    <!-- ================================================= -->
                    <!-- PASO 2 -->
                    <!-- ================================================= -->

                    <StackPanel x:Name="panelCodigo"
                                Visibility="Collapsed">

                        <Image Source="/Images/Logo.png"
                               Width="150"
                               Height="150"
                               Margin="0,0,0,10"/>


                        <TextBlock Text="VERIFICACIÓN"
                                   Foreground="White"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   FontFamily="Montserrat"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,10"/>


                        <TextBlock Text="Ingresá el código de recuperación"
                                   Foreground="DarkGray"
                                   FontSize="12"
                                   FontFamily="Montserrat"
                                   TextAlignment="Center"
                                   Margin="0,0,0,25"/>


                        <TextBlock Text="Código"
                                   Foreground="DarkGray"
                                   FontSize="12"
                                   FontWeight="Medium"
                                   FontFamily="Montserrat"/>


                        <TextBox x:Name="txtCodigo"
                                 FontSize="18"
                                 FontWeight="Bold"
                                 FontFamily="Montserrat"
                                 Foreground="Black"
                                 CaretBrush="LightGray"
                                 BorderBrush="DarkGray"
                                 BorderThickness="0,0,0,2"
                                 Height="35"
                                 VerticalContentAlignment="Center"
                                 HorizontalContentAlignment="Center"
                                 MaxLength="6"
                                 Margin="0,5,0,0"
                                 Padding="5,0,0,0"/>


                        <TextBlock x:Name="lblTiempo"
                                   Text="El código vence en 05:00"
                                   Foreground="DarkGray"
                                   FontSize="11"
                                   FontFamily="Montserrat"
                                   HorizontalAlignment="Center"
                                   Margin="0,10,0,0"/>


                        <Button x:Name="btnVerificarCodigo"
                                BorderThickness="0"
                                Content="VERIFICAR"
                                Foreground="White"
                                FontSize="12"
                                FontFamily="Montserrat"
                                Cursor="Hand"
                                Margin="0,30,0,0"
                                Click="btnVerificarCodigo_Click">

                            <Button.Style>

                                <Style TargetType="Button">

                                    <Setter Property="Background"
                                            Value="#462AD8"/>

                                    <Style.Triggers>

                                        <Trigger Property="IsMouseOver"
                                                 Value="True">

                                            <Setter Property="Background"
                                                    Value="#28AEED"/>

                                        </Trigger>

                                    </Style.Triggers>

                                </Style>

                            </Button.Style>


                            <Button.Template>

                                <ControlTemplate TargetType="Button">

                                    <Border Width="150"
                                            Height="40"
                                            CornerRadius="20"
                                            Background="{TemplateBinding Background}">

                                        <ContentPresenter
                                            VerticalAlignment="Center"
                                            HorizontalAlignment="Center"/>

                                    </Border>

                                </ControlTemplate>

                            </Button.Template>

                        </Button>

                    </StackPanel>


                    <!-- ================================================= -->
                    <!-- PASO 3 -->
                    <!-- ================================================= -->

                    <StackPanel x:Name="panelNuevaPassword"
                                Visibility="Collapsed">

                        <Image Source="/Images/Logo.png"
                               Width="150"
                               Height="150"
                               Margin="0,0,0,10"/>


                        <TextBlock Text="NUEVA CONTRASEÑA"
                                   Foreground="White"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   FontFamily="Montserrat"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,20"/>


                        <TextBlock Text="Nueva contraseña"
                                   Foreground="DarkGray"
                                   FontSize="12"
                                   FontWeight="Medium"
                                   FontFamily="Montserrat"/>


                        <PasswordBox x:Name="txtNuevaPassword"
                                     FontSize="13"
                                     FontWeight="Medium"
                                     FontFamily="Montserrat"
                                     Foreground="Black"
                                     CaretBrush="LightGray"
                                     BorderBrush="DarkGray"
                                     BorderThickness="0,0,0,2"
                                     Height="28"
                                     VerticalContentAlignment="Center"
                                     Margin="0,5,0,0"
                                     Padding="5,0,0,0"/>


                        <TextBlock Text="Confirmar contraseña"
                                   Foreground="DarkGray"
                                   FontSize="12"
                                   FontWeight="Medium"
                                   FontFamily="Montserrat"
                                   Margin="0,20,0,0"/>


                        <PasswordBox x:Name="txtConfirmarPassword"
                                     FontSize="13"
                                     FontWeight="Medium"
                                     FontFamily="Montserrat"
                                     Foreground="Black"
                                     CaretBrush="LightGray"
                                     BorderBrush="DarkGray"
                                     BorderThickness="0,0,0,2"
                                     Height="28"
                                     VerticalContentAlignment="Center"
                                     Margin="0,5,0,0"
                                     Padding="5,0,0,0"/>


                        <Button x:Name="btnCambiarPassword"
                                BorderThickness="0"
                                Content="CAMBIAR CONTRASEÑA"
                                Foreground="White"
                                FontSize="11"
                                FontFamily="Montserrat"
                                Cursor="Hand"
                                Margin="0,35,0,0"
                                Click="btnCambiarPassword_Click">

                            <Button.Style>

                                <Style TargetType="Button">

                                    <Setter Property="Background"
                                            Value="#462AD8"/>

                                    <Style.Triggers>

                                        <Trigger Property="IsMouseOver"
                                                 Value="True">

                                            <Setter Property="Background"
                                                    Value="#28AEED"/>

                                        </Trigger>

                                    </Style.Triggers>

                                </Style>

                            </Button.Style>


                            <Button.Template>

                                <ControlTemplate TargetType="Button">

                                    <Border Width="180"
                                            Height="40"
                                            CornerRadius="20"
                                            Background="{TemplateBinding Background}">

                                        <ContentPresenter
                                            VerticalAlignment="Center"
                                            HorizontalAlignment="Center"/>

                                    </Border>

                                </ControlTemplate>

                            </Button.Template>

                        </Button>

                    </StackPanel>

                </Grid>

            </Grid>

        </Border>

    </Border>

</Window>