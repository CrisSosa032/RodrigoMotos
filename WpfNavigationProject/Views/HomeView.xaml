<UserControl x:Class="WpfNavigationProject.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">

    <Border Background="White" CornerRadius="15" Padding="30" Effect="{StaticResource ShadowDepth3}">
        <StackPanel>
            <TextBlock Text="Inicio (Home)" 
                       FontSize="36" 
                       FontWeight="Bold" 
                       Foreground="#333333" 
                       Margin="0,0,0,15"/>

            <TextBlock Text="¡Bienvenido a la página principal de tu aplicación WPF!" 
                       FontSize="18" 
                       Foreground="#555555" 
                       Margin="0,0,0,10"/>

            <TextBlock Text="Utiliza el menú lateral para navegar entre las diferentes secciones del proyecto. Este contenido se carga dentro del Frame principal." 
                       FontSize="16" 
                       TextWrapping="Wrap"
                       Foreground="#777777"/>

            <!-- Ejemplo de una tarjeta informativa -->
            <Border BorderBrush="#483C90" BorderThickness="1" Background="#EBEFFF" CornerRadius="10" Padding="15" Margin="0,25,0,0">
                <StackPanel>
                    <TextBlock Text="Sugerencia Rápida" 
                               FontSize="14" 
                               FontWeight="SemiBold" 
                               Foreground="#483C90"/>
                    <TextBlock Text="Usa el menu lateral para acceder a las demas vistas" 
                               FontSize="14" 
                               Foreground="#555555" 
                               TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </Border>

    <UserControl.Resources>
        <!-- Definición de una sombra simple para embellecer la vista -->
        <DropShadowEffect x:Key="ShadowDepth3" 
                          Color="Black" 
                          Direction="270" 
                          ShadowDepth="3" 
                          BlurRadius="5" 
                          Opacity="0.1"/>
    </UserControl.Resources>
</UserControl>