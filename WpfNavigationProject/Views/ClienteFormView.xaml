<UserControl x:Class="WpfNavigationProject.Views.ClienteFormView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="550" d:DesignWidth="800">

    <Grid Margin="20">
        <Border Background="#F9F9F9" 
                CornerRadius="10" 
                Padding="30" 
                BorderBrush="#DDD" 
                BorderThickness="1"
                HorizontalAlignment="Center" 
                VerticalAlignment="Center">

            <Grid Width="600" VerticalAlignment="Top">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="0.5*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="25"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="15"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="15"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="15"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="30"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Label Content="Registro de Clientes" 
                       Grid.Column="0" 
                       Grid.ColumnSpan="3" 
                       FontSize="24" 
                       FontWeight="Bold" 
                       Foreground="#007ACC" 
                       Margin="0,0,0,20"/>

                <Label Grid.Column="0" Content="Nombre y Apellido:" 
                       Grid.Row="2" VerticalAlignment="Center" FontWeight="SemiBold"/>
                <TextBox Grid.Column="1" Grid.Row="2" 
                         Name="TxtNombre"
                         Padding="5" 
                         VerticalContentAlignment="Center" 
                         Height="35"/>

                <Label Grid.Column="0" Content="Nro de Documento:" 
                       Grid.Row="4" VerticalAlignment="Center" FontWeight="SemiBold"/>
                <TextBox Grid.Column="1" Grid.Row="4" 
                         Name="TxtDNI"
                         Padding="5" 
                         VerticalContentAlignment="Center" 
                         Height="35"/>

                <Label Grid.Column="0" Content="Nro de Celular:" 
                       Grid.Row="6" VerticalAlignment="Center" FontWeight="SemiBold"/>
                <TextBox Grid.Column="1" Grid.Row="6" 
                         Name="TxtCelular"
                         Padding="5" 
                         VerticalContentAlignment="Center" 
                         Height="35"/>

                <Label Grid.Column="0" Content="Dirección:" 
                       Grid.Row="8" VerticalAlignment="Center" FontWeight="SemiBold"/>
                <TextBox Grid.Column="1" Grid.Row="8" 
                         Name="TxtDireccion"
                         Padding="5" 
                         VerticalContentAlignment="Center" 
                         Height="35"/>

                <Button Grid.Column="0" 
                        Name="BtnCargar" 
                        Content="Guardar Cliente" 
                        Grid.Row="10" 
                        Grid.ColumnSpan="2"
                        Margin="0,15,0,0"
                        HorizontalAlignment="Center"
                        Width="200"
                        Height="40" Click="BtnCargar_Click"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>