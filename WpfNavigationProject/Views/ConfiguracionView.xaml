<UserControl x:Class="WpfNavigationProject.Views.ConfiguracionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:WpfNavigationProject.Views"
             mc:Ignorable="d"
             d:DesignHeight="450"
             d:DesignWidth="800"
             Background="Transparent">

    <!-- =========================================================
     RECURSOS
     ========================================================= -->
    <UserControl.Resources>
        <DropShadowEffect x:Key="ShadowDepth3" Color="Black" Direction="270" ShadowDepth="3" BlurRadius="5" Opacity="0.1"/>
        <DropShadowEffect x:Key="CardShadow" Color="Black" Direction="270" ShadowDepth="2" BlurRadius="6" Opacity="0.12"/>
    </UserControl.Resources>

    <!-- =========================================================
     CONTENEDOR PRINCIPAL
     ========================================================= -->
    <Border Background="White"
        CornerRadius="15"
        Padding="30"
        Effect="{StaticResource ShadowDepth3}">

        <Grid Cursor="">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- TÍTULO -->
            <TextBlock Grid.Row="0"
                   Text="Gestión de Usuarios"
                   FontSize="36"
                   FontWeight="Bold"
                   Foreground="#333333"
                   Margin="0,0,0,20"
                   TextAlignment="Center"/>

            <!-- =================================================
     LISTADO DE USUARIOS
     ================================================= -->
            <ScrollViewer Grid.Row="1"
         VerticalScrollBarVisibility="Auto"
         HorizontalScrollBarVisibility="Disabled">

                <ItemsControl Name="UsuariosDataGrid" HorizontalAlignment="Center">

                    <!-- WRAP PANEL PARA CONTROLAR EL TAMAÑO Y ORDEN DE LAS CARDS -->
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel ItemWidth="380" ItemHeight="95" HorizontalAlignment="Center"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>


                    <!-- =================================================
             CARD DE USUARIO COMPACTA
             ================================================= -->
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#F8F9FA"
                    CornerRadius="10"
                    Margin="8"
                    Padding="12,10"
                    Effect="{StaticResource CardShadow}"
                    BorderBrush="#E3E6E8"
                    BorderThickness="1">

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- ÍCONO -->
                                    <Border Grid.Column="0"
                            Width="38" Height="38"
                            Background="#007ACC"
                            CornerRadius="19"
                            VerticalAlignment="Center"
                            Margin="0,0,12,0">
                                        <TextBlock Text="👤" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>

                                    <!-- DATOS DEL USUARIO -->
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Username}" FontSize="15" FontWeight="Bold" Foreground="#333333"/>
                                            <TextBlock Text=" (" Foreground="#777777" FontSize="12" VerticalAlignment="Bottom"/>
                                            <TextBlock Text="{Binding Rol}" Foreground="#777777" FontSize="12" VerticalAlignment="Bottom"/>
                                            <TextBlock Text=")" Foreground="#777777" FontSize="12" VerticalAlignment="Bottom"/>
                                        </StackPanel>

                                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                            <TextBlock Text="Nombre: " FontSize="12" Foreground="#555555" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding Nombre}" FontSize="12" Foreground="#333333"/>
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- BOTÓN EDITAR -->
                                    <Button Grid.Column="2"
                            Content="✏️ Editar"
                            Width="85"
                            Height="28"
                            VerticalAlignment="Center"
                            Style="{StaticResource AccionButtonStyle}"
                            Click="BtnEditarUsuario_Click"
                            Cursor="Hand"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- NUEVO USUARIO -->
            <Button Grid.Row="2"
                Content="+ Nuevo Usuario"
                Name="BtnNuevoUsuario"
                Style="{StaticResource AccionButtonStyle}"
                Margin="0,20,0,0"
                HorizontalAlignment="Center"
                Width="180"
                Height="35"
                Click="BtnNuevoUsuario_Click"
                Cursor="Hand"/>
        </Grid>
    </Border>
</UserControl>