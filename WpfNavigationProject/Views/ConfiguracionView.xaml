<UserControl x:Class="WpfNavigationProject.Views.ConfiguracionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:WpfNavigationProject.Views"
             mc:Ignorable="d"
             d:DesignHeight="450"
             d:DesignWidth="800"
             Background="Transparent">

    <!-- =========================================================
         RECURSOS
         ========================================================= -->
    <UserControl.Resources>

        <DropShadowEffect x:Key="ShadowDepth3"
                          Color="Black"
                          Direction="270"
                          ShadowDepth="3"
                          BlurRadius="5"
                          Opacity="0.1"/>

    </UserControl.Resources>


    <!-- =========================================================
         CONTENEDOR PRINCIPAL
         ========================================================= -->
    <Border Background="White"
            CornerRadius="15"
            Padding="30"
            Effect="{StaticResource ShadowDepth3}">

        <Grid>

            <Grid.RowDefinitions>
                <!-- Título -->
                <RowDefinition Height="Auto"/>

                <!-- Tabla -->
                <RowDefinition Height="*"/>

                <!-- Botón -->
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>


            <!-- =================================================
                 TÍTULO
                 ================================================= -->
            <TextBlock Grid.Row="0"
                       Text="Gestión de Usuarios"
                       FontSize="36"
                       FontWeight="Bold"
                       Foreground="#333333"
                       Margin="0,0,0,15"
                       TextAlignment="Center"/>


            <!-- =================================================
                 TABLA DE USUARIOS
                 ================================================= -->
            <DataGrid Grid.Row="1"
                      Name="UsuariosDataGrid"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      SelectionMode="Single"
                      GridLinesVisibility="Horizontal"
                      RowBackground="LightGray"
                      AlternatingRowBackground="#FFEFEFEF"
                      CanUserResizeColumns="True"
                      Foreground="#FF2A2A2A"
                      FontSize="14"
                      FontWeight="SemiBold"
                      HeadersVisibility="Column">

                <!-- CABECERA -->
                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="{x:Type DataGridColumnHeader}">

                        <Setter Property="Background"
                                Value="#FF007ACC"/>

                        <Setter Property="Foreground"
                                Value="White"/>

                        <Setter Property="HorizontalContentAlignment"
                                Value="Center"/>

                        <Setter Property="Padding"
                                Value="5"/>

                    </Style>
                </DataGrid.ColumnHeaderStyle>


                <!-- COLUMNAS -->
                <DataGrid.Columns>

                    <!-- ID -->
                    <DataGridTextColumn Header="ID Usuario"
                                        Binding="{Binding IdUsuario}"
                                        Width="100"/>


                    <!-- USERNAME -->
                    <DataGridTextColumn Header="Usuario"
                                        Binding="{Binding Username}"
                                        Width="*"/>


                    <!-- NOMBRE -->
                    <DataGridTextColumn Header="Nombre"
                                        Binding="{Binding Nombre}"
                                        Width="*"/>


                    <!-- ROL -->
                    <DataGridTextColumn Header="Rol"
                                        Binding="{Binding Rol}"
                                        Width="150">

                        <DataGridTextColumn.ElementStyle>

                            <Style TargetType="TextBlock">

                                <Setter Property="HorizontalAlignment"
                                        Value="Center"/>

                            </Style>

                        </DataGridTextColumn.ElementStyle>

                    </DataGridTextColumn>


                    <!-- ACCIONES -->
                    <DataGridTemplateColumn Header="Acciones"
                                            Width="180">

                        <DataGridTemplateColumn.CellTemplate>

                            <DataTemplate>

                                <StackPanel Orientation="Horizontal"
                                            HorizontalAlignment="Center">

                                    <Button Content="✏️ Editar"
                                            Margin="2"
                                            Style="{StaticResource AccionButtonStyle}"/>

                                    <Button Content="🗑️ Eliminar"
                                            Margin="2"
                                            Style="{StaticResource PeligroButtonStyle}"/>

                                </StackPanel>

                            </DataTemplate>

                        </DataGridTemplateColumn.CellTemplate>

                    </DataGridTemplateColumn>

                </DataGrid.Columns>

            </DataGrid>


            <!-- =================================================
                 NUEVO USUARIO
                 ================================================= -->
            <Button Grid.Row="2"
                    Content="+ Nuevo Usuario"
                    Name="BtnNuevoUsuario"
                    Style="{StaticResource AccionButtonStyle}"
                    Margin="0,20,0,0"
                    HorizontalAlignment="Center"
                    Width="180"
                    Height="35"/>

        </Grid>

    </Border>

</UserControl>

